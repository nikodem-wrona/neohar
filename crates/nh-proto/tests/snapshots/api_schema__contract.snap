          "type": "integer"
        },
        "data": {
          "anyOf": [
            {
              "$ref": "#/$defs/ErrorData"
            },
            {
              "type": "null"
            }
          ]
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "type": "object"
    },
    "RunId": {
      "description": "The ULID of a run of an agent, as 26 characters.",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
      "type": "string"
    },
    "ScrollbackParams": {
