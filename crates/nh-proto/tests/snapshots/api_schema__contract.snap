            "string",
            "null"
          ]
        }
      },
      "required": [
        "plan"
      ],
      "type": "object"
    },
    "PolicyAdd": {
      "properties": {
        "rule": {
          "$ref": "#/$defs/PolicyRule"
        }
      },
      "required": [
        "rule"
      ],
      "type": "object"
    },
    "PolicyAdded": {
      "properties": {
        "id": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "PolicyDecision": {
      "enum": [
        "allow",
        "deny"
      ],
      "type": "string"
    },
    "PolicyEvent": {
      "description": "The payload of `policy.added` and `policy.removed`.",
      "properties": {
        "id": {
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/PolicyScope"
        }
      },
      "required": [
