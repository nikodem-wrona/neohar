---
source: crates/nh-proto/tests/api_schema.rs
expression: document()
---
{
  "$defs": {
    "AdapterDeliveryAck": {
      "description": "The shim applied the decision. It sends this just before it prints.",
      "properties": {
        "applied": {
          "type": "boolean"
        },
        "idempotency_key": {
          "type": "string"
        },
        "interaction": {
          "$ref": "#/$defs/InteractionId"
        }
      },
      "required": [
        "interaction",
        "idempotency_key",
        "applied"
      ],
      "type": "object"
    },
    "AdapterDisagreement": {
      "description": "A lower source disagreed with a structured one.",
      "properties": {
        "facet": {
          "$ref": "#/$defs/Facet"
        },
        "other": true,
        "run": {
          "$ref": "#/$defs/RunId"
        },
        "structured": true
      },
      "required": [
        "run",
        "facet",
        "structured",
        "other"
      ],
      "type": "object"
    },
    "AdapterGate": {
      "description": "The params of `adapter.gate` are those of a signal. The shim holds the hook until the core\nanswers.",
      "properties": {
        "event": {
          "type": "string"
        },
        "harness": {
          "$ref": "#/$defs/Harness"
        },
        "payload": true,
        "token": {
          "type": "string"
        },
        "truncated": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "token",
        "harness",
        "event",
        "payload"
      ],
      "type": "object"
    },
    "AdapterGateResume": {
      "description": "A shim whose connection dropped asks for its interaction again, once.",
      "properties": {
        "interaction": {
          "$ref": "#/$defs/InteractionId"
        }
      },
      "required": [
        "interaction"
      ],
      "type": "object"
    },
    "AdapterHealth": {
      "oneOf": [
        {
          "properties": {
            "state": {
              "const": "healthy",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        },
        {
          "properties": {
            "reason": {
              "type": "string"
            },
            "state": {
              "const": "degraded",
              "type": "string"
            }
          },
          "required": [
            "state",
            "reason"
          ],
          "type": "object"
        },
        {
          "properties": {
            "state": {
              "const": "disconnected",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        },
        {
          "properties": {
            "state": {
              "const": "unvalidated_version",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        }
      ]
    },
    "AdapterReceipt": {
      "description": "The receipt for a signal. The shim does not care what is in it.",
      "properties": {
        "ok": {
          "type": "boolean"
        }
      },
      "required": [
        "ok"
      ],
      "type": "object"
    },
    "AdapterSignal": {
      "description": "A hook of a harness, as the shim sends it. The payload is the raw JSON that the\nharness wrote to the stdin of the hook.",
      "properties": {
        "event": {
          "description": "The name of the hook event, for example `PreToolUse`.",
          "type": "string"
        },
        "harness": {
          "$ref": "#/$defs/Harness"
        },
        "payload": true,
        "token": {
          "description": "The `NEOHAR_PANE_TOKEN` of the pane.",
          "type": "string"
        },
        "truncated": {
          "default": false,
          "description": "The shim cut the payload at its cap of 4 MiB.",
          "type": "boolean"
        }
      },
      "required": [
        "token",
        "harness",
        "event",
        "payload"
      ],
      "type": "object"
    },
    "AgentChoices": {
      "description": "The models and the effort levels that `agent.start` can choose.",
      "properties": {
        "harness": {
          "anyOf": [
            {
              "$ref": "#/$defs/Harness"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "AgentChoicesResult": {
      "properties": {
        "harnesses": {
          "items": {
            "$ref": "#/$defs/HarnessChoices"
          },
          "type": "array"
        }
      },
      "required": [
        "harnesses"
      ],
      "type": "object"
    },
    "AgentDetected": {
      "description": "A run was seen. It is not identified yet.",
      "properties": {
        "harness": {
          "$ref": "#/$defs/Harness"
        },
        "run": {
          "$ref": "#/$defs/RunId"
        },
        "via": {
          "description": "How the core found it: `launch`, `hook`, `process`, `screen`.",
          "type": "string"
        }
      },
      "required": [
        "run",
        "harness",
        "via"
      ],
      "type": "object"
    },
    "AgentDriftDetected": {
      "properties": {
        "bad_signal_rate": {
          "format": "float",
          "type": "number"
        },
        "harness": {
          "$ref": "#/$defs/Harness"
        },
        "observations": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "harness",
        "version",
        "observations",
        "bad_signal_rate"
      ],
      "type": "object"
    },
    "AgentHarnessVersionUnvalidated": {
      "properties": {
        "harness": {
          "$ref": "#/$defs/Harness"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "harness",
        "version"
      ],
      "type": "object"
    },
    "AgentIdentified": {
      "description": "A run got its session id and its pane.",
      "properties": {
        "harness": {
          "$ref": "#/$defs/Harness"
        },
        "pane": {
          "anyOf": [
            {
              "$ref": "#/$defs/PaneId"
            },
            {
              "type": "null"
            }
          ]
        },
        "run": {
          "$ref": "#/$defs/RunId"
        },
        "session_id": {
          "type": "string"
        }
      },
      "required": [
        "run",
        "harness",
        "session_id"
      ],
      "type": "object"
    },
    "AgentInterrupt": {
      "properties": {
        "agent": {
          "$ref": "#/$defs/RefRunId"
        }
      },
      "required": [
        "agent"
      ],
      "type": "object"
    },
    "AgentLink": {
      "description": "Binds a run to a pane by the user's decision.",
      "properties": {
        "harness": {
          "anyOf": [
            {
              "$ref": "#/$defs/Harness"
            },
            {
              "type": "null"
            }
          ]
        },
        "pane": {
          "$ref": "#/$defs/RefPaneId"
        },
        "session_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "thread": {
          "description": "The thread of a Codex run on the shared daemon.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "pane"
      ],
      "type": "object"
    },
    "AgentLinked": {
      "properties": {
        "run": {
          "$ref": "#/$defs/RunId"
        }
      },
      "required": [
        "run"
      ],
      "type": "object"
    },
    "AgentList": {
      "properties": {
        "harness": {
          "anyOf": [
            {
              "$ref": "#/$defs/Harness"
            },
            {
              "type": "null"
            }
          ]
        },
        "pane": {
          "anyOf": [
            {
              "$ref": "#/$defs/RefPaneId"
            },
            {
              "type": "null"
            }
          ]
        },
        "workspace": {
          "anyOf": [
            {
              "$ref": "#/$defs/RefWorkspaceId"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "AgentListResult": {
      "properties": {
        "agents": {
          "items": {
            "$ref": "#/$defs/AgentValue"
          },
          "type": "array"
        }
      },
      "required": [
        "agents"
      ],
      "type": "object"
    },
    "AgentMove": {
      "description": "Puts a run at another place on the board of every window. The order stays across a restart\nof the core, and a new run in the pane of a run that ended takes its place.",
      "properties": {
        "agent": {
          "$ref": "#/$defs/RefRunId"
        },
        "index": {
          "description": "The place among the runs, counted from 0. A place after the last run is the end.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "agent",
        "index"
      ],
      "type": "object"
    },
    "AgentPrompt": {
      "description": "Types a prompt into a bound run (never into a suggested one).",
      "properties": {
        "agent": {
          "$ref": "#/$defs/RefRunId"
        },
        "submit": {
          "default": true,
          "description": "Press Enter after the text.",
          "type": "boolean"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "agent",
        "text"
      ],
      "type": "object"
    },
    "AgentReply": {
      "description": "The next prompt for a run that is `idle` and has no open interaction. The\ncore writes the text as a bracketed paste and a carriage return, at most once for an\n`input_id`, and takes no geometry lease.",
      "properties": {
        "input_id": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "run": {
          "$ref": "#/$defs/RefRunId"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "run",
        "input_id",
        "text"
      ],
      "type": "object"
    },
    "AgentResume": {
      "description": "Starts the harness again with the resume handle of the run. It returns a job.",
      "properties": {
        "agent": {
          "$ref": "#/$defs/RefRunId"
        },
        "placement": {
          "anyOf": [
            {
              "$ref": "#/$defs/Placement"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "agent"
      ],
      "type": "object"
    },
    "AgentShow": {
      "properties": {
        "agent": {
          "$ref": "#/$defs/RefRunId"
        }
      },
      "required": [
        "agent"
      ],
      "type": "object"
    },
    "AgentShown": {
      "properties": {
        "agent": {
          "$ref": "#/$defs/AgentValue"
        }
      },
      "required": [
        "agent"
      ],
      "type": "object"
    },
    "AgentStart": {
      "description": "`agent.start` returns a job. The run appears in the `agents` projection.",
      "properties": {
        "args": {
          "description": "Extra arguments for the harness.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "cwd": {
          "type": [
            "string",
            "null"
          ]
        },
        "effort": {
          "description": "The effort level (`high`). Without it, the harness uses the level of its own settings.\nA manifest without `effort_arg` refuses it.",
          "type": [
            "string",
            "null"
          ]
        },
        "harness": {
          "$ref": "#/$defs/Harness"
        },
        "model": {
          "description": "The model, as the harness names it (`opus`, `gpt-5.5`). Without it, the harness uses\nthe model of its own settings.",
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "description": "A unique name for the run. A call can use it instead of the id.",
          "type": [
            "string",
            "null"
          ]
        },
        "placement": {
          "$ref": "#/$defs/Placement"
        },
        "prompt": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "harness",
        "placement"
      ],
      "type": "object"
    },
    "AgentStateChanged": {
      "description": "Every change of a facet.",
      "properties": {
        "confidence": {
          "format": "float",
          "type": "number"
        },
        "facet": {
          "$ref": "#/$defs/Facet"
        },
        "from": true,
        "run": {
          "$ref": "#/$defs/RunId"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "to": true
      },
      "required": [
        "run",
        "facet",
        "from",
        "to",
        "source",
        "confidence"
      ],
      "type": "object"
    },
    "AgentStop": {
      "description": "Asks the agent to end. With `force` the core ends the process.",
      "properties": {
        "agent": {
          "$ref": "#/$defs/RefRunId"
        },
        "force": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "agent"
      ],
      "type": "object"
    },
    "AgentUnlink": {
      "properties": {
        "agent": {
          "$ref": "#/$defs/RefRunId"
        }
      },
      "required": [
        "agent"
      ],
      "type": "object"
    },
    "AgentValue": {
      "description": "`agents`: one run of Claude Code or Codex.",
      "properties": {
        "binding": {
          "$ref": "#/$defs/Binding"
        },
        "capabilities": {
          "$ref": "#/$defs/Capabilities"
        },
        "facets": {
          "$ref": "#/$defs/Facets"
        },
        "harness": {
          "$ref": "#/$defs/Harness"
        },
        "harness_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "$ref": "#/$defs/RunId"
        },
        "isolation": {
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "description": "The unique name, if the run has one. A call can use it instead of the id.",
          "type": [
            "string",
            "null"
          ]
        },
        "pane": {
          "anyOf": [
            {
              "$ref": "#/$defs/PaneId"
            },
            {
              "type": "null"
            }
          ]
        },
        "rate_limit": {
          "anyOf": [
            {
              "$ref": "#/$defs/RateLimitWindow"
            },
            {
              "type": "null"
            }
          ]
        },
        "resumable": {
          "default": false,
          "description": "A resume handle exists (`claude --resume`, `codex resume`).",
          "type": "boolean"
        },
        "session_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "started_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "usage": {
          "$ref": "#/$defs/Usage"
        },
        "yolo": {
          "default": false,
          "description": "The run bypasses the permission prompts of the harness.",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "harness",
        "binding",
        "facets",
        "capabilities",
        "usage",
        "started_at"
      ],
      "type": "object"
    },
    "AgentWait": {
      "properties": {
        "agent": {
          "$ref": "#/$defs/RefRunId"
        },
        "timeout_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "until": {
          "$ref": "#/$defs/WaitFor"
        }
      },
      "required": [
        "agent",
        "until"
      ],
      "type": "object"
    },
    "AgentWaitResult": {
      "properties": {
        "agent": {
          "$ref": "#/$defs/AgentValue"
        },
        "reached": {
          "description": "`false` when the time ran out.",
          "type": "boolean"
        }
      },
      "required": [
        "reached",
        "agent"
      ],
      "type": "object"
    },
    "AnswerChannel": {
      "description": "How an answer can reach the harness.",
      "enum": [
        "native",
        "keystroke"
      ],
      "type": "string"
    },
    "ApprovalDecision": {
      "properties": {
        "always": {
          "default": false,
          "description": "\"Allow always\": a rule for the session.",
          "type": "boolean"
        },
        "behavior": {
          "$ref": "#/$defs/Behavior"
        },
        "message": {
          "description": "The text for a deny. The model sees it.",
          "type": [
            "string",
            "null"
          ]
        },
        "persist": {
          "default": false,
          "description": "With `always`: write the rule to the settings of the harness. It needs\n`approvals.claude.persist_always`.",
          "type": "boolean"
        },
        "stop": {
          "default": false,
          "description": "\"Deny and stop\": the turn ends.",
          "type": "boolean"
        }
      },
      "required": [
        "behavior"
      ],
      "type": "object"
    },
    "ApprovalPayload": {
      "properties": {
        "command": {
          "anyOf": [
            {
              "$ref": "#/$defs/Command"
            },
            {
              "type": "null"
            }
          ]
        },
        "cwd": {
          "type": [
            "string",
            "null"
          ]
        },
        "diff": {
          "anyOf": [
            {
              "$ref": "#/$defs/Diff"
            },
            {
              "type": "null"
            }
          ]
        },
        "input": {
          "description": "The input of a tool that has no special card, cut at a cap."
        },
        "paths": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "peek": {
          "description": "The last lines of the pane, for the context strip.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "policy_note": {
          "description": "A rule of the policy matches this request, but the core cannot answer it,\nfor example \"The rule `pnpm-test` would allow this.\"",
          "type": [
            "string",
            "null"
          ]
        },
        "tool": {
          "description": "The tool: `Bash`, `Edit`, `exec_command`, an MCP tool.",
          "type": "string"
        }
      },
      "required": [
        "tool"
      ],
      "type": "object"
    },
    "AskpassAnswered": {
      "description": "The answer of the person, or `null` when the person cancelled. The core keeps it nowhere:\nnot in an event, not in a log.",
      "properties": {
        "answer": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "AskpassAsk": {
      "description": "`askpass.ask`: a question of `ssh` that the app asks the person. `nh askpass`\ncalls it with the text that ssh gave. Only the host in the process of the core answers.",
      "properties": {
        "machine": {
          "description": "The label of the machine that the link is for, when the core knows it.",
          "type": [
            "string",
            "null"
          ]
        },
        "prompt": {
          "description": "The question as ssh wrote it: a host key, a passphrase or a password.",
          "type": "string"
        }
      },
      "required": [
        "prompt"
      ],
      "type": "object"
    },
    "AttentionReason": {
      "oneOf": [
        {
          "enum": [
            "approval",
            "question",
            "plan_review",
            "error",
            "rate_limited"
          ],
          "type": "string"
        },
        {
          "const": "turn_ended",
          "description": "The turn of the run ended while its pane had no focus, and nobody looked at the pane or\ntyped into it since.",
          "type": "string"
        }
      ]
    },
    "AttentionValue": {
      "description": "`attention`: a run that needs the user, in the order of urgency. The number of\nentries is the badge count.",
      "properties": {
        "interactions": {
          "items": {
            "$ref": "#/$defs/InteractionId"
          },
          "type": "array"
        },
        "reasons": {
          "items": {
            "$ref": "#/$defs/AttentionReason"
          },
          "type": "array"
        },
        "run": {
          "$ref": "#/$defs/RunId"
        },
        "since": {
          "$ref": "#/$defs/Timestamp"
        },
        "urgency": {
          "$ref": "#/$defs/Urgency"
        }
      },
      "required": [
        "run",
        "urgency",
        "reasons",
        "interactions",
        "since"
      ],
      "type": "object"
    },
    "Axis": {
      "description": "How a split node lays out its children.",
      "oneOf": [
        {
          "const": "row",
          "description": "Side by side, from left to right.",
          "type": "string"
        },
        {
          "const": "column",
          "description": "One above the other, from top to bottom.",
          "type": "string"
        }
      ]
    },
    "Behavior": {
      "enum": [
        "allow",
        "deny"
      ],
      "type": "string"
    },
    "Binding": {
      "description": "How sure the core is about the pane of a run.",
      "oneOf": [
        {
          "description": "Deterministic: neohar started the run, a signal carried the token of the pane, or the\nuser linked it.",
          "properties": {
            "state": {
              "const": "bound",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        },
        {
          "description": "Correlation only. It can drive display, and never an answer.",
          "properties": {
            "confidence": {
              "format": "float",
              "type": "number"
            },
            "state": {
              "const": "suggested",
              "type": "string"
            }
          },
          "required": [
            "state",
            "confidence"
          ],
          "type": "object"
        },
        {
          "properties": {
            "state": {
              "const": "unlinked",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        }
      ]
    },
    "Bounds": {
      "description": "The bounds of a window on the screen, in logical pixels.",
      "properties": {
        "height": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "width": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "x": {
          "format": "int32",
          "type": "integer"
        },
        "y": {
          "format": "int32",
          "type": "integer"
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "type": "object"
    },
    "Bytes": {
      "contentEncoding": "base64",
      "description": "Bytes as base64 (standard alphabet, with padding).",
      "type": "string"
    },
    "CallError": {
      "description": "The error as a caller sees it: `{code, message, details}`.",
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "details": true,
        "message": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "type": "object"
    },
    "Capabilities": {
      "description": "What neohar can do with the run. The UI offers only what is listed.",
      "properties": {
        "answer_keystroke": {
          "type": "boolean"
        },
        "answer_native": {
          "description": "The kinds of interaction that have a native channel.",
          "items": {
            "$ref": "#/$defs/InteractionKind"
          },
          "type": "array"
        },
        "gate": {
          "type": "boolean"
        },
        "observe": {
          "type": "boolean"
        },
        "reconcile": {
          "type": "boolean"
        },
        "resume": {
          "type": "boolean"
        },
        "steer": {
          "type": "boolean"
        },
        "survive_disconnect": {
          "type": "boolean"
        }
      },
      "required": [
        "observe",
        "gate",
        "answer_native",
        "answer_keystroke",
        "reconcile",
        "resume",
        "steer",
        "survive_disconnect"
      ],
      "type": "object"
    },
    "CapabilityRow": {
      "description": "One row of the capability matrix.",
      "properties": {
        "capabilities": {
          "$ref": "#/$defs/Capabilities"
        },
        "harness": {
          "$ref": "#/$defs/Harness"
        },
        "mode": {
          "$ref": "#/$defs/LaunchMode"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "harness",
        "version",
        "mode",
        "capabilities"
      ],
      "type": "object"
    },
    "ChangeRow": {
      "description": "`changes_for:<window>`: one changed file. The key is `path`.",
      "properties": {
        "add": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "binary": {
          "default": false,
          "description": "Git shows no lines for the file.",
          "type": "boolean"
        },
        "del": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "dir": {
          "description": "The folder of the path with a `/` at its end, or empty for a file at the root.",
          "type": "string"
        },
        "name": {
          "description": "The last part of the path.",
          "type": "string"
        },
        "old_path": {
          "description": "The path in `HEAD` of a renamed file.",
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "description": "The path from the root of the worktree.",
          "type": "string"
        },
        "stamp": {
          "description": "Changes when the file in the worktree changes, so that an open diff loads again. It is\n0 for a deleted file, and less than 2^53 so that JavaScript holds it exactly.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "status": {
          "$ref": "#/$defs/ChangeStatus"
        }
      },
      "required": [
        "path",
        "dir",
        "name",
        "status",
        "add",
        "del",
        "stamp"
      ],
      "type": "object"
    },
    "ChangeStatus": {
      "description": "What happened to a file since `HEAD`. A change of type counts as `modified`.",
      "oneOf": [
        {
          "enum": [
            "modified",
            "added",
            "deleted",
            "renamed"
          ],
          "type": "string"
        },
        {
          "const": "untracked",
          "description": "A file that git does not track and does not ignore.",
          "type": "string"
        }
      ]
    },
    "ChangeTotals": {
      "description": "`changes` of `changes_head:<window>`: the totals of the changes of a worktree.",
      "properties": {
        "error": {
          "description": "Why the last count failed, for example \"the worktree is gone\". The other values and\nthe rows are those of the count before.",
          "type": [
            "string",
            "null"
          ]
        },
        "files": {
          "description": "The changed files, also those after the first 1,000.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "truncated": {
          "default": false,
          "description": "The worktree has more than 1,000 changed files, and `changes_for:<window>` has the\nfirst 1,000.",
          "type": "boolean"
        }
      },
      "required": [
        "files"
      ],
      "type": "object"
    },
    "ChangesDiff": {
      "description": "`changes.diff` gives the diff of one path of the rows of `changes_for:<window>`.",
      "properties": {
        "path": {
          "type": "string"
        },
        "window": {
          "$ref": "#/$defs/WindowId"
        }
      },
      "required": [
        "window",
        "path"
      ],
      "type": "object"
    },
    "ChangesFollow": {
      "description": "`changes.follow`: the Changes tab of a window shows the changes of the git worktree that\nholds `path`. The core fills `changes_head:<window>` and `changes_for:<window>`\nwhile the window follows one of them, and counts again when the worktree changes.",
      "properties": {
        "path": {
          "description": "An absolute path: the folder of the Files tab of the window.",
          "type": "string"
        },
        "window": {
          "$ref": "#/$defs/WindowId"
        }
      },
      "required": [
        "window",
        "path"
      ],
      "type": "object"
    },
    "ChangesHead": {
      "description": "`changes_head:<window>`: the head of the Changes tab of a window. The window names a\nfolder with `changes.follow`, and the changes are those of the git worktree that holds\nit, from `HEAD`: what is not committed. The core makes the row when it knows the worktree.",
      "properties": {
        "branch": {
          "description": "The branch of `HEAD`, or `None` for a detached `HEAD`.",
          "type": [
            "string",
            "null"
          ]
        },
        "changes": {
          "anyOf": [
            {
              "$ref": "#/$defs/ChangeTotals"
            },
            {
              "type": "null"
            }
          ],
          "description": "The totals of the last count, or `None` before the first count."
        },
        "diff_stats": {
          "anyOf": [
            {
              "$ref": "#/$defs/DiffStats"
            },
            {
              "type": "null"
            }
          ],
          "description": "The lines of all changed files."
        },
        "folder": {
          "description": "The folder that the window named.",
          "type": "string"
        },
        "root": {
          "description": "The root of the git worktree that holds the folder, or `None` when the folder is not\nin a git worktree.",
          "type": [
            "string",
            "null"
          ]
        },
        "trust": {
          "anyOf": [
            {
              "$ref": "#/$defs/GitTrustAsk"
            },
            {
              "type": "null"
            }
          ],
          "description": "The core runs no git command in the repository until the person trusts it. Then\n`root` is the root of the worktree, and the head has no branch and no count."
        }
      },
      "required": [
        "folder"
      ],
      "type": "object"
    },
    "CheckStatus": {
      "description": "How a check of the doctor came out.",
      "oneOf": [
        {
          "enum": [
            "ok"
          ],
          "type": "string"
        },
        {
          "const": "info",
          "description": "A fact that needs no action.",
          "type": "string"
        },
        {
          "const": "warn",
          "description": "Something works, with a limit or a risk.",
          "type": "string"
        },
        {
          "const": "fail",
          "description": "Something does not work.",
          "type": "string"
        }
      ]
    },
    "ClipboardDropped": {
      "description": "An OSC 52 clipboard write that no client got: the client that sent the last\ninput to the pane is not connected.",
      "properties": {
        "at": {
          "$ref": "#/$defs/Timestamp"
        },
        "bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "bytes",
        "at"
      ],
      "type": "object"
    },
    "ClipboardRequest": {
      "description": "An OSC 52 clipboard write that waits for an answer.",
      "properties": {
        "allowed": {
          "default": false,
          "description": "The pane has a remembered Allow, and the last input came from a phone: the write waits\nonly for the tap on Copy, which the clipboard of a phone needs.",
          "type": "boolean"
        },
        "bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "preview": {
          "type": "string"
        }
      },
      "required": [
        "bytes",
        "preview"
      ],
      "type": "object"
    },
    "Command": {
      "description": "A shell command, for an approval card.",
      "properties": {
        "argv": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "cwd": {
          "type": "string"
        },
        "display": {
          "$ref": "#/$defs/Spans"
        },
        "policy_hint": {
          "type": [
            "string",
            "null"
          ]
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "risk": {
          "$ref": "#/$defs/Risk"
        }
      },
      "required": [
        "argv",
        "display",
        "cwd",
        "risk",
        "reasons"
      ],
      "type": "object"
    },
    "ConfigGet": {
      "properties": {
        "section": {
          "description": "One section, for example `approvals`. Without it all sections.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "ConfigReload": {
      "type": "object"
    },
    "ConfigReloaded": {
      "properties": {
        "errors": {
          "description": "Errors of the files. The old values stay in force.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "errors"
      ],
      "type": "object"
    },
    "ConfigSet": {
      "description": "Sets a value in `config.toml`. The file keeps its comments and its order. A `null` removes\nthe key, so the default applies again.",
      "properties": {
        "key": {
          "description": "The path, for example `approvals.mode`.",
          "type": "string"
        },
        "value": true
      },
      "required": [
        "key",
        "value"
      ],
      "type": "object"
    },
    "ConfigValues": {
      "properties": {
        "sections": {
          "additionalProperties": {
            "$ref": "#/$defs/SettingsSection"
          },
          "type": "object"
        }
      },
      "required": [
        "sections"
      ],
      "type": "object"
    },
    "CopyResult": {
      "properties": {
        "text": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "Cursor": {
      "description": "A place in the event log. `log_epoch` changes when the log starts again, and a cursor of\nanother epoch is stale.",
      "properties": {
        "log_epoch": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "machine_uuid": {
          "type": "string"
        },
        "seq": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "session_uuid": {
          "type": "string"
        }
      },
      "required": [
        "machine_uuid",
        "session_uuid",
        "log_epoch",
        "seq"
      ],
      "type": "object"
    },
    "DebugAnswer": {
      "description": "`debug.answer`: decides an interaction the way a client would, and may hold the delivery\nback so that a test can control the order of events.",
      "properties": {
        "by": {
          "default": "debug",
          "type": "string"
        },
        "decision": {
          "$ref": "#/$defs/Decision"
        },
        "hold": {
          "default": false,
          "description": "Record the decision and do not deliver it. A later `debug.deliver` does.",
          "type": "boolean"
        },
        "interaction": {
          "$ref": "#/$defs/RefInteractionId"
        },
        "via": {
          "$ref": "#/$defs/Via"
        }
      },
      "required": [
        "interaction",
        "decision",
        "via"
      ],
      "type": "object"
    },
    "DebugAnswered": {
      "properties": {
        "rev": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "state": {
          "$ref": "#/$defs/InteractionState"
        }
      },
      "required": [
        "rev",
        "state"
      ],
      "type": "object"
    },
    "DebugBundle": {
      "description": "`debug.bundle`: writes a zip for a bug report. Everything in it has passed the redaction.",
      "properties": {
        "include_scrollback": {
          "default": false,
          "description": "Add the text of the panes. Without it the bundle has no scrollback.",
          "type": "boolean"
        },
        "out": {
          "description": "The file to write. The CLI always gives one. Without it the core writes\n`neohar-debug-<time>.zip` in the directory of the logs.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "DebugBundled": {
      "properties": {
        "bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "files": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "bytes",
        "files"
      ],
      "type": "object"
    },
    "DebugRestoredScreen": {
      "description": "The screen of a restored pane at the end of the replay.",
      "properties": {
        "dump": {
          "description": "A `ScreenDump` of `nh-term`."
        },
        "fed_offset": {
          "description": "The journal offset at the end of the replay.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "fed_offset",
        "dump"
      ],
      "type": "object"
    },
    "DebugScreen": {
      "description": "`debug.screen`: what a pane shows, with the journal offset it belongs to. The pane can be\none that `debug.spawn_panes` started, outside the layout.",
      "properties": {
        "dump": {
          "default": true,
          "description": "Include the cells (`dump`). A call without them is cheap.",
          "type": "boolean"
        },
        "pane": {
          "$ref": "#/$defs/PaneId"
        }
      },
      "required": [
        "pane"
      ],
      "type": "object"
    },
    "DebugScreenResult": {
      "properties": {
        "asked_size": {
          "description": "The size that the last resize request asked for, as columns and rows.",
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0,
              "type": "integer"
            },
            {
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0,
              "type": "integer"
            }
          ],
          "type": "array"
        },
        "dump": {
          "description": "The cells, the cursor, the modes and the title (a `ScreenDump` of `nh-term`). Only with\n`dump`."
        },
        "fed_offset": {
          "description": "The journal offset that the engine read up to. With `dump`, the offset of the dump.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "pane": {
          "$ref": "#/$defs/PaneId"
        },
        "recovery": {
          "description": "How the pane got its screen: `fresh`, `snapshot`, `journal` or `ring_only`.",
          "type": "string"
        },
        "restored": {
          "anyOf": [
            {
              "$ref": "#/$defs/DebugRestoredScreen"
            },
            {
              "type": "null"
            }
          ],
          "description": "The screen at the end of the replay. Only with `dump`, and only for a pane that a\nrestart restored."
        },
        "restoring": {
          "description": "The pane reads the journal after a restart and shows no final screen yet.",
          "type": "boolean"
        },
        "settled": {
          "description": "The pane has read its journal and the resize nudge is over. A pane that was not\nrestored is settled from the start.",
          "type": "boolean"
        },
        "since_resize_ms": {
          "description": "How long ago the engine last changed its size.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "size": {
          "description": "The size of the engine, as columns and rows.",
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0,
              "type": "integer"
            },
            {
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0,
              "type": "integer"
            }
          ],
          "type": "array"
        }
      },
      "required": [
        "pane",
        "fed_offset",
        "since_resize_ms",
        "restoring",
        "settled",
        "recovery",
        "asked_size",
        "size"
      ],
      "type": "object"
    },
    "DebugSpawnPanes": {
      "description": "`debug.spawn_panes`: panes for a test, outside the layout. No window draws them. The panes\nstart one after the other and run the same program.",
      "properties": {
        "argv": {
          "description": "The program and its arguments. Without it, the `SHELL` of the core, else `/bin/sh`.",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "cols": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "count": {
          "default": 1,
          "description": "How many panes, from 1 to 64.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "cwd": {
          "type": [
            "string",
            "null"
          ]
        },
        "env": {
          "description": "Extra variables for the environment, as pairs of a name and a value.",
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "type": "string"
              }
            ],
            "type": "array"
          },
          "type": "array"
        },
        "isolated_home": {
          "default": false,
          "description": "Give each pane its own `HOME`, `CLAUDE_CONFIG_DIR` and `CODEX_HOME` in the data\ndirectory of the session, so that a harness never touches the real ones. Without\n`cwd`, the pane starts in that `HOME`.",
          "type": "boolean"
        },
        "rows": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "cols",
        "rows"
      ],
      "type": "object"
    },
    "DebugSpawned": {
      "properties": {
        "panes": {
          "items": {
            "$ref": "#/$defs/DebugSpawnedPane"
          },
          "type": "array"
        }
      },
      "required": [
        "panes"
      ],
      "type": "object"
    },
    "DebugSpawnedPane": {
      "description": "A pane that `debug.spawn_panes` started.",
      "properties": {
        "pane": {
          "$ref": "#/$defs/PaneId"
        },
        "render_id": {
          "description": "The number of the pane in the render frames.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "pane",
        "render_id"
      ],
      "type": "object"
    },
    "Decision": {
      "oneOf": [
        {
          "$ref": "#/$defs/ApprovalDecision",
          "properties": {
            "kind": {
              "const": "approval",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "$ref": "#/$defs/QuestionDecision",
          "properties": {
            "kind": {
              "const": "question",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "$ref": "#/$defs/PlanDecision",
          "properties": {
            "kind": {
              "const": "plan_review",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "DeliveryInfo": {
      "properties": {
        "attempts": {
          "description": "How many times the core tried to deliver.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "decided_by": {
          "description": "Who decided: a client name, `policy`, or the id of a window.",
          "type": [
            "string",
            "null"
          ]
        },
        "fail_reason": {
          "description": "Why the delivery failed, when the state is `failed`.",
          "type": [
            "string",
            "null"
          ]
        },
        "rev": {
          "description": "The revision of the decision.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "via": {
          "anyOf": [
            {
              "$ref": "#/$defs/Via"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "rev",
        "attempts"
      ],
      "type": "object"
    },
    "DeviceId": {
      "description": "The ULID of a client device, as 26 characters.",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
      "type": "string"
    },
    "Diff": {
      "properties": {
        "files": {
          "items": {
            "$ref": "#/$defs/FileDiff"
          },
          "type": "array"
        }
      },
      "required": [
        "files"
      ],
      "type": "object"
    },
    "DiffLine": {
      "properties": {
        "intra": {
          "description": "The changed ranges inside the line, in UTF-16 code units of `text`.",
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              },
              {
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              }
            ],
            "type": "array"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "kind": {
          "$ref": "#/$defs/LineKind"
        },
        "new": {
          "description": "The line number in the new file. A context line and an added line have one.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "old": {
          "description": "The line number in the old file. A context line and a deleted line have one.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "text": {
          "$ref": "#/$defs/Spans"
        }
      },
      "required": [
        "kind",
        "text"
      ],
      "type": "object"
    },
    "DiffStats": {
      "properties": {
        "add": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "del": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "add",
        "del"
      ],
      "type": "object"
    },
    "DoctorCheck": {
      "properties": {
        "detail": {
          "type": "string"
        },
        "hint": {
          "description": "What the person can do about it.",
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "description": "A stable name, for example `runtime_dir`.",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/CheckStatus"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "status",
        "detail"
      ],
      "type": "object"
    },
    "DoctorReport": {
      "description": "`doctor.run`: the checks of `nh doctor`. The same facts feed `health`.",
      "properties": {
        "checks": {
          "items": {
            "$ref": "#/$defs/DoctorCheck"
          },
          "type": "array"
        }
      },
      "required": [
        "checks"
      ],
      "type": "object"
    },
    "DoctorRun": {
      "type": "object"
    },
    "DoctorWarning": {
      "properties": {
        "hint": {
          "description": "What the user can do, for example a command.",
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "text"
      ],
      "type": "object"
    },
    "DroppedBlob": {
      "description": "A file that a client put in the blob store (`BlobPut`), with the name it had.",
      "properties": {
        "hash": {
          "description": "The BLAKE3 digest in hex that the upload answered.",
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "hash",
        "name"
      ],
      "type": "object"
    },
    "Empty": {
      "description": "An empty result or empty params: `{}`.",
      "type": "object"
    },
    "ErrorCode": {
      "description": "The string code of an error. The codes are part of the contract, and this list is complete: the\ncore, the hosts and the link send no other code. To send a new code, add it here first. The UI\nand the CLI act on a few of them (`already_answered`, `confirm_required`, `not_found`,\n`unsupported`). On the wire a code is its `snake_case` name.",
      "oneOf": [
        {
          "const": "parse_error",
          "description": "The line is not JSON (-32700).",
          "type": "string"
        },
        {
          "const": "invalid_request",
          "description": "The JSON is not a request (-32600).",
          "type": "string"
        },
        {
          "const": "method_not_found",
          "description": "The method does not exist (-32601).",
          "type": "string"
        },
        {
          "const": "invalid_params",
          "description": "The params do not fit the method (-32602).",
          "type": "string"
        },
        {
          "const": "not_found",
          "description": "The thing that the call names does not exist.",
          "type": "string"
        },
        {
          "const": "pane_gone",
          "description": "The pane exists and has no process: its holder starts, the program ended before the core\nrestarted, or the holder is lost. `pane.restart` starts the program again.",
          "type": "string"
        },
        {
          "const": "permission_denied",
          "description": "The caller may not call this method, or not on this thing.",
          "type": "string"
        },
        {
          "const": "already_answered",
          "description": "Another client answered the interaction first. `details` has `{by, via, decision}`.",
          "type": "string"
        },
        {
          "const": "input_unconfirmed",
          "description": "An input was in flight when the holder or the core went away. `details` has `{input_id, reason}`.",
          "type": "string"
        },
        {
          "const": "delivery_unknown",
          "description": "The core cannot say whether an answer reached the harness.",
          "type": "string"
        },
        {
          "const": "degraded_storage",
          "description": "The store is read-only or full. The core runs, but it does not keep changes.",
          "type": "string"
        },
        {
          "const": "confirm_required",
          "description": "The call needs a second call with `force`. `details` says what the user would lose.",
          "type": "string"
        },
        {
          "const": "stale_version",
          "description": "The caller worked with an older version of the thing. Read it again.",
          "type": "string"
        },
        {
          "const": "busy",
          "description": "The core is busy with the same work. Try again.",
          "type": "string"
        },
        {
          "const": "harness_unavailable",
          "description": "The harness of a start is not installed, or it is logged out after a new probe.\n`details` has `{harness, reason, hint}`, and `reason` is `not_installed` or\n`logged_out`.",
          "type": "string"
        },
        {
          "const": "unsupported",
          "description": "The method exists in the contract, and the core has no handler for it yet.",
          "type": "string"
        },
        {
          "const": "link_down",
          "description": "The link to the core of a machine is down. A call fails with it at once, and a\ncall in flight when the link went down fails with it too: its outcome is unknown.",
          "type": "string"
        },
        {
          "const": "version_mismatch",
          "description": "The core of a machine has another major version of the API.",
          "type": "string"
        },
        {
          "const": "not_idle",
          "description": "`agent.reply` on a run that works or has an open interaction. `details` has\n`{execution, pending}`.",
          "type": "string"
        },
        {
          "const": "pane_busy",
          "description": "The pane runs a program or an agent, and the call needs an idle shell.",
          "type": "string"
        },
        {
          "const": "pane_spawn_failed",
          "description": "The core cannot start the holder or the program of a pane.",
          "type": "string"
        },
        {
          "const": "holder_error",
          "description": "The holder of a pane failed or sent something that the core does not accept.",
          "type": "string"
        },
        {
          "const": "agent_live",
          "description": "The agent still runs, and the call needs an agent that has ended.",
          "type": "string"
        },
        {
          "const": "agent_gone",
          "description": "The agent has ended, and the call needs a live agent.",
          "type": "string"
        },
        {
          "const": "not_bound",
          "description": "The run is not linked to its pane, so the core types nothing into it.",
          "type": "string"
        },
        {
          "const": "name_taken",
          "description": "A live agent has the name already.",
          "type": "string"
        },
        {
          "const": "harness_mismatch",
          "description": "The run in the pane is of another harness than the call names.",
          "type": "string"
        },
        {
          "const": "manifest_error",
          "description": "The manifest of a start has a value that is not correct.",
          "type": "string"
        },
        {
          "const": "interaction_closed",
          "description": "The interaction has ended. `details` has `{state}`.",
          "type": "string"
        },
        {
          "const": "not_answerable",
          "description": "No channel reaches the harness of the interaction, so nothing can answer it.",
          "type": "string"
        },
        {
          "const": "gate_unavailable",
          "description": "This core does not hold the gates of the hooks.",
          "type": "string"
        },
        {
          "const": "cancelled",
          "description": "The job of the call was cancelled.",
          "type": "string"
        },
        {
          "const": "timeout",
          "description": "The work of the call did not end in time.",
          "type": "string"
        },
        {
          "const": "too_large",
          "description": "The request, the file or the blob is larger than the limit.",
          "type": "string"
        },
        {
          "const": "blob_corrupt",
          "description": "The bytes of a blob do not agree with its hash.",
          "type": "string"
        },
        {
          "const": "conflict",
          "description": "A policy rule with the same id exists.",
          "type": "string"
        },
        {
          "const": "config_rule",
          "description": "The policy rule is in `config.toml`, so only a change of that file removes it.",
          "type": "string"
        },
        {
          "const": "git_failed",
          "description": "A command of git failed.",
          "type": "string"
        },
        {
          "const": "forward_failed",
          "description": "The core cannot forward the port of a machine.",
          "type": "string"
        },
        {
          "const": "proto_unsupported",
          "description": "The client decodes another version of the frame format.",
          "type": "string"
        },
        {
          "const": "io_error",
          "description": "The core cannot write a file.",
          "type": "string"
        },
        {
          "const": "store_error",
          "description": "The database failed.",
          "type": "string"
        },
        {
          "const": "internal",
          "description": "A fault of the core. The log has the reason.",
          "type": "string"
        }
      ]
    },
    "ErrorData": {
      "description": "The `error.data` of an application error.",
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "details": true
      },
      "required": [
        "code"
      ],
      "type": "object"
    },
    "Event": {
      "description": "An entry of the log.",
      "properties": {
        "at": {
          "$ref": "#/$defs/Timestamp"
        },
        "kind": {
          "description": "The kind, for example `agent.state_changed`.",
          "type": "string"
        },
        "payload": true,
        "seq": {
          "description": "The place in the log. It grows by one for each event.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "subject": {
          "description": "The id of the main object, as text.",
          "type": [
            "string",
            "null"
          ]
        },
        "v": {
          "description": "The version of the payload. A payload only gets new fields within a version.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "seq",
        "at",
        "kind",
        "v",
        "payload"
      ],
      "type": "object"
    },
    "EventFilter": {
      "description": "Which events a subscription wants.",
      "properties": {
        "kinds": {
          "description": "Kinds. A trailing `*` is a prefix: `interaction.*`. Without it all kinds match.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "subject": {
          "description": "Only events about this object.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "EventNotification": {
      "description": "The params of the notification `events.event`.",
      "properties": {
        "event": {
          "$ref": "#/$defs/Event"
        },
        "subscription": {
          "type": "string"
        }
      },
      "required": [
        "subscription",
        "event"
      ],
      "type": "object"
    },
    "EventsSubscribe": {
      "description": "`events.subscribe {cursor, filter}`. Events arrive as `events.event`\nnotifications. A client whose cursor is older than the retention, or from another\n`log_epoch`, gets `events.truncated` and takes a fresh snapshot.",
      "properties": {
        "cursor": {
          "anyOf": [
            {
              "$ref": "#/$defs/Cursor"
            },
            {
              "type": "null"
            }
          ],
          "description": "Where to start. Without it the subscription starts at the end of the log."
        },
        "filter": {
          "$ref": "#/$defs/EventFilter",
          "default": {}
        }
      },
      "type": "object"
    },
    "EventsSubscribed": {
      "properties": {
        "cursor": {
          "$ref": "#/$defs/Cursor",
          "description": "The cursor of the end of the log at the moment of the call."
        },
        "subscription": {
          "description": "The id of the subscription, as it is in the notifications.",
          "type": "string"
        }
      },
      "required": [
        "subscription",
        "cursor"
      ],
      "type": "object"
    },
    "EventsTruncated": {
      "description": "The params of the notification `events.truncated`.",
      "properties": {
        "cursor": {
          "$ref": "#/$defs/Cursor",
          "description": "The cursor to start from after a fresh snapshot."
        },
        "subscription": {
          "type": "string"
        }
      },
      "required": [
        "subscription",
        "cursor"
      ],
      "type": "object"
    },
    "EventsUnsubscribe": {
      "properties": {
        "subscription": {
          "type": "string"
        }
      },
      "required": [
        "subscription"
      ],
      "type": "object"
    },
    "Execution": {
      "oneOf": [
        {
          "properties": {
            "state": {
              "const": "starting",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        },
        {
          "properties": {
            "state": {
              "const": "working",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        },
        {
          "properties": {
            "state": {
              "const": "idle",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        },
        {
          "properties": {
            "state": {
              "const": "error",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        },
        {
          "properties": {
            "resets_at": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Timestamp"
                },
                {
                  "type": "null"
                }
              ]
            },
            "state": {
              "const": "rate_limited",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        },
        {
          "properties": {
            "state": {
              "const": "exited",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        },
        {
          "properties": {
            "state": {
              "const": "unknown",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        }
      ]
    },
    "ExecutionFacet": {
      "properties": {
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "value": {
          "$ref": "#/$defs/Execution"
        }
      },
      "required": [
        "value",
        "provenance"
      ],
      "type": "object"
    },
    "Facet": {
      "enum": [
        "liveness",
        "execution",
        "pending",
        "adapter_health"
      ],
      "type": "string"
    },
    "Facets": {
      "description": "The five facets of a run.",
      "properties": {
        "adapter_health": {
          "$ref": "#/$defs/HealthFacet"
        },
        "execution": {
          "$ref": "#/$defs/ExecutionFacet"
        },
        "liveness": {
          "$ref": "#/$defs/LivenessFacet"
        },
        "pending": {
          "description": "The ids of the open interactions.",
          "items": {
            "$ref": "#/$defs/InteractionId"
          },
          "type": "array"
        },
        "read_state": {
          "$ref": "#/$defs/ReadState"
        }
      },
      "required": [
        "liveness",
        "execution",
        "pending",
        "adapter_health",
        "read_state"
      ],
      "type": "object"
    },
    "FileAction": {
      "enum": [
        "created",
        "modified",
        "removed",
        "unchanged"
      ],
      "type": "string"
    },
    "FileChange": {
      "properties": {
        "action": {
          "$ref": "#/$defs/FileAction"
        },
        "backup": {
          "description": "The backup that the installer wrote before the first change.",
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "action"
      ],
      "type": "object"
    },
    "FileDiff": {
      "properties": {
        "hunks": {
          "items": {
            "$ref": "#/$defs/Hunk"
          },
          "type": "array"
        },
        "path": {
          "type": "string"
        },
        "stats": {
          "$ref": "#/$defs/DiffStats"
        },
        "status": {
          "$ref": "#/$defs/FileStatus"
        },
        "truncated": {
          "default": false,
          "description": "The diff of this file was cut at 2,000 lines. The UI offers \"open full\".",
          "type": "boolean"
        }
      },
      "required": [
        "path",
        "status",
        "hunks",
        "stats"
      ],
      "type": "object"
    },
    "FileStatus": {
      "enum": [
        "modified",
        "added",
        "deleted",
        "renamed"
      ],
      "type": "string"
    },
    "FloatingPane": {
      "properties": {
        "pane": {
          "$ref": "#/$defs/PaneId"
        },
        "rect": {
          "$ref": "#/$defs/Rect"
        }
      },
      "required": [
        "pane",
        "rect"
      ],
      "type": "object"
    },
    "FsCopyPath": {
      "description": "`fs.copy_path`: the core writes a path to the clipboard of the device that called.",
      "properties": {
        "path": {
          "description": "An absolute path.",
          "type": "string"
        },
        "relative_to": {
          "description": "A folder that holds `path`. The clipboard gets the path from this folder.",
          "type": [
            "string",
            "null"
          ]
        },
        "return_text": {
          "default": false,
          "description": "Return the text, and write no clipboard of a host: a phone writes it in the tap.",
          "type": "boolean"
        }
      },
      "required": [
        "path"
      ],
      "type": "object"
    },
    "FsEntry": {
      "properties": {
        "hidden": {
          "description": "The name starts with a dot. The tree shows the entry dim.",
          "type": "boolean"
        },
        "icon": {
          "description": "The name of the icon of the entry in the Material Icon Theme, by its name:\n`folder` and `file` when no other icon fits. A folder has the name of its closed icon.",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/FsEntryKind"
        },
        "link": {
          "description": "The entry is a symlink. `kind` is the kind of its target.",
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "path": {
          "description": "The absolute path, for `fs.list`, `fs.read` and the actions of a row.",
          "type": "string"
        }
      },
      "required": [
        "name",
        "path",
        "kind",
        "hidden",
        "link",
        "icon"
      ],
      "type": "object"
    },
    "FsEntryKind": {
      "oneOf": [
        {
          "const": "dir",
          "description": "A folder, or a symlink to a folder. It opens in the tree.",
          "type": "string"
        },
        {
          "const": "file",
          "description": "A regular file, or a symlink to one. It opens in the file view.",
          "type": "string"
        },
        {
          "const": "other",
          "description": "A socket, a pipe, a device or a broken link. The tree shows it and opens nothing.",
          "type": "string"
        }
      ]
    },
    "FsList": {
      "description": "`fs.list`: the entries of a folder of the machine, for the Files tab.",
      "properties": {
        "path": {
          "description": "An absolute path.",
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "type": "object"
    },
    "FsListResult": {
      "description": "The entries of a folder in the order of the tree: the folders first, then the other\nentries, each group by name without case. `.git` and `.DS_Store` are not there.",
      "properties": {
        "entries": {
          "items": {
            "$ref": "#/$defs/FsEntry"
          },
          "type": "array"
        },
        "path": {
          "description": "The folder that the core listed, as an absolute path.",
          "type": "string"
        },
        "truncated": {
          "description": "True when the folder has more entries than the core sends (2,000).",
          "type": "boolean"
        }
      },
      "required": [
        "path",
        "entries",
        "truncated"
      ],
      "type": "object"
    },
    "FsOpen": {
      "description": "`fs.open`: the host of the window opens a path, or shows it in the Finder.",
      "properties": {
        "path": {
          "description": "An absolute path.",
          "type": "string"
        },
        "reveal": {
          "default": false,
          "description": "Show the path in the Finder, and do not open it.",
          "type": "boolean"
        },
        "window": {
          "$ref": "#/$defs/WindowId"
        }
      },
      "required": [
        "window",
        "path"
      ],
      "type": "object"
    },
    "FsPreviewKind": {
      "oneOf": [
        {
          "const": "text",
          "description": "Lines of text with their highlight.",
          "type": "string"
        },
        {
          "const": "image",
          "description": "An image that the page shows from `image`.",
          "type": "string"
        },
        {
          "const": "binary",
          "description": "Bytes that are not text. The view shows only `info`.",
          "type": "string"
        }
      ]
    },
    "FsRead": {
      "description": "`fs.read`: the preview of a regular file of the machine.",
      "properties": {
        "path": {
          "description": "An absolute path.",
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "type": "object"
    },
    "FsReadResult": {
      "properties": {
        "icon": {
          "description": "The icon of the file, as in `FsEntry`.",
          "type": "string"
        },
        "image": {
          "description": "A `data:` URL of an image of at most 8 MiB.",
          "type": [
            "string",
            "null"
          ]
        },
        "info": {
          "description": "The text of the head of the file view, for example \"120 lines · 4.2 KB\".",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/FsPreviewKind"
        },
        "lines": {
          "description": "One line of text for each line of the file, with its highlight. Empty for an image\nand for a binary file.",
          "items": {
            "$ref": "#/$defs/Spans"
          },
          "type": "array"
        },
        "markdown": {
          "anyOf": [
            {
              "$ref": "#/$defs/Markdown"
            },
            {
              "type": "null"
            }
          ],
          "description": "The HTML of a Markdown file of at most 256 KiB."
        },
        "name": {
          "description": "The last part of the path.",
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "truncated": {
          "description": "The file has more than the core sends: 1 MiB or 10,000 lines.",
          "type": "boolean"
        }
      },
      "required": [
        "path",
        "name",
        "icon",
        "kind",
        "info",
        "lines",
        "truncated"
      ],
      "type": "object"
    },
    "GateMode": {
      "description": "Whether the core holds the hook of the harness.",
      "enum": [
        "gate",
        "observe"
      ],
      "type": "string"
    },
    "GateReply": {
      "anyOf": [
        {
          "description": "The core opened an interaction, and the hook waits. A `adapter.gate_result`\nnotification follows on the same connection.",
          "properties": {
            "interaction": {
              "$ref": "#/$defs/InteractionId"
            },
            "lease": {
              "description": "The lease of this connection.",
              "type": "string"
            },
            "wait": {
              "type": "boolean"
            }
          },
          "required": [
            "wait",
            "interaction",
            "lease"
          ],
          "type": "object"
        },
        {
          "description": "The decision is known at once (policy, or a decision recorded before a resume).",
          "properties": {
            "idempotency_key": {
              "type": "string"
            },
            "interaction": {
              "$ref": "#/$defs/InteractionId"
            },
            "output": {
              "description": "What the shim prints on stdout. The shim does not read it.",
              "type": "string"
            }
          },
          "required": [
            "interaction",
            "output",
            "idempotency_key"
          ],
          "type": "object"
        },
        {
          "description": "The hook prints nothing, and the harness shows its own dialog.",
          "properties": {
            "no_decision": {
              "type": "boolean"
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "no_decision",
            "reason"
          ],
          "type": "object"
        }
      ],
      "description": "The first reply to `adapter.gate` and to `adapter.gate_resume`."
    },
    "GateResult": {
      "anyOf": [
        {
          "properties": {
            "idempotency_key": {
              "type": "string"
            },
            "interaction": {
              "$ref": "#/$defs/InteractionId"
            },
            "output": {
              "type": "string"
            }
          },
          "required": [
            "interaction",
            "output",
            "idempotency_key"
          ],
          "type": "object"
        },
        {
          "properties": {
            "interaction": {
              "$ref": "#/$defs/InteractionId"
            },
            "no_decision": {
              "type": "boolean"
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "interaction",
            "no_decision",
            "reason"
          ],
          "type": "object"
        }
      ],
      "description": "The params of the notification `adapter.gate_result`: the end of a wait."
    },
    "GitAgent": {
      "description": "An agent whose pane folder is in a worktree.",
      "properties": {
        "harness": {
          "$ref": "#/$defs/Harness"
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "pane": {
          "$ref": "#/$defs/PaneId"
        },
        "run": {
          "$ref": "#/$defs/RunId"
        },
        "state": {
          "$ref": "#/$defs/GitAgentState"
        }
      },
      "required": [
        "run",
        "pane",
        "harness",
        "state"
      ],
      "type": "object"
    },
    "GitAgentState": {
      "description": "The state of an agent in a worktree, as the Git view shows it.",
      "oneOf": [
        {
          "enum": [
            "starting",
            "working",
            "idle",
            "exited",
            "unknown"
          ],
          "type": "string"
        },
        {
          "const": "waiting",
          "description": "The agent has an open approval, question or plan.",
          "type": "string"
        }
      ]
    },
    "GitBranchKind": {
      "enum": [
        "local",
        "remote"
      ],
      "type": "string"
    },
    "GitBranchList": {
      "description": "The rows of `git_branches:<window>` for a worktree, in their order.",
      "properties": {
        "branches": {
          "items": {
            "$ref": "#/$defs/GitBranchValue"
          },
          "type": "array"
        }
      },
      "required": [
        "branches"
      ],
      "type": "object"
    },
    "GitBranchValue": {
      "description": "`git_branches:<window>`: a branch of the repository of the Git view. The key is\n`reference`. The branch of `HEAD` comes first, then the recent ones, then the other local\nones and then the remote ones, each the newest commit first.",
      "properties": {
        "ahead": {
          "default": 0,
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "behind": {
          "default": 0,
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "current": {
          "default": false,
          "description": "The worktree of the Git view has it out.",
          "type": "boolean"
        },
        "kind": {
          "$ref": "#/$defs/GitBranchKind"
        },
        "name": {
          "description": "For example `main` or `origin/main`.",
          "type": "string"
        },
        "recent": {
          "default": false,
          "description": "The worktree had it out a short time ago.",
          "type": "boolean"
        },
        "reference": {
          "description": "For example `refs/heads/main`.",
          "type": "string"
        },
        "subject": {
          "description": "The subject of its last commit.",
          "type": [
            "string",
            "null"
          ]
        },
        "time": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ],
          "description": "The time of its last commit."
        },
        "time_text": {
          "description": "For example \"3 days ago\".",
          "type": [
            "string",
            "null"
          ]
        },
        "upstream": {
          "description": "The upstream of a local branch, for example `origin/main`.",
          "type": [
            "string",
            "null"
          ]
        },
        "worktree": {
          "description": "Another worktree has the branch out, so a switch to it goes to that worktree.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name",
        "reference",
        "kind"
      ],
      "type": "object"
    },
    "GitChanges": {
      "description": "What a switch does with the changes of the worktree.",
      "oneOf": [
        {
          "const": "bring",
          "description": "The changes go to the other branch, as `git switch` takes them. A change that the\nother branch would overwrite stops the switch (`conflict`).",
          "type": "string"
        },
        {
          "const": "leave",
          "description": "The changes go to a stash that names the branch. A switch back to that branch offers\nthem again (`stash` of `git_head`).",
          "type": "string"
        }
      ]
    },
    "GitCommit": {
      "description": "A commit of the History of the Git view.",
      "properties": {
        "author": {
          "type": "string"
        },
        "branches": {
          "description": "The branches at the commit, for example `main` and `origin/main`.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "hash": {
          "type": "string"
        },
        "head": {
          "default": false,
          "description": "`HEAD` is at this commit.",
          "type": "boolean"
        },
        "short": {
          "type": "string"
        },
        "subject": {
          "type": "string"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "time": {
          "$ref": "#/$defs/Timestamp",
          "description": "The time of the author."
        },
        "time_text": {
          "description": "For example \"3 hours ago\".",
          "type": "string"
        },
        "unpushed": {
          "default": false,
          "description": "No remote branch has the commit, so a push would send it. Always false in a repository\nwith no remote.",
          "type": "boolean"
        }
      },
      "required": [
        "hash",
        "short",
        "subject",
        "author",
        "time",
        "time_text"
      ],
      "type": "object"
    },
    "GitDiff": {
      "description": "`git.diff`: the diff of one file. Without `commit`, the file is a row of the changes of the\nworktree, from `HEAD`. With `commit`, it is a file of that commit, from its first parent.",
      "properties": {
        "commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "file": {
          "description": "The path of the file from the root of the worktree.",
          "type": "string"
        },
        "path": {
          "description": "The worktree that holds this absolute path. The CLI gives the current directory.",
          "type": [
            "string",
            "null"
          ]
        },
        "window": {
          "anyOf": [
            {
              "$ref": "#/$defs/WindowId"
            },
            {
              "type": "null"
            }
          ],
          "description": "The worktree that the Git view of this window shows."
        }
      },
      "required": [
        "file"
      ],
      "type": "object"
    },
    "GitFetch": {
      "description": "`git.fetch`: fetches the remote of the head with `--prune`, as a job. A question of ssh or\nof a credential helper shows the sheet of the app.",
      "properties": {
        "path": {
          "description": "The worktree that holds this absolute path. The CLI gives the current directory.",
          "type": [
            "string",
            "null"
          ]
        },
        "window": {
          "anyOf": [
            {
              "$ref": "#/$defs/WindowId"
            },
            {
              "type": "null"
            }
          ],
          "description": "The worktree that the Git view of this window shows."
        }
      },
      "type": "object"
    },
    "GitFollow": {
      "description": "`git.follow`: the Git view of a window shows the git worktree that holds `path`. The core\nfills `git_head:<window>`, `git_worktrees:<window>`, `git_branches:<window>` and\n`git_changes:<window>` while the window follows one of them, and looks again when the\nworktree or its git directory changes.",
      "properties": {
        "path": {
          "description": "An absolute path in the worktree: the folder of a pane, or a row of `git_worktrees`.",
          "type": "string"
        },
        "window": {
          "$ref": "#/$defs/WindowId"
        }
      },
      "required": [
        "window",
        "path"
      ],
      "type": "object"
    },
    "GitHead": {
      "description": "`git_head:<window>`: what the Git view of a window shows. The window names a folder with\n`git.follow`, and the head is that of the git worktree that holds it. The core makes the\nrow when it knows the worktree.",
      "properties": {
        "agents": {
          "description": "The agents whose pane folder is in the worktree.",
          "items": {
            "$ref": "#/$defs/GitAgent"
          },
          "type": "array"
        },
        "ahead": {
          "default": 0,
          "description": "The commits of the branch that its upstream does not have.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "behind": {
          "default": 0,
          "description": "The commits of the upstream that the branch does not have.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "branch": {
          "description": "The branch of `HEAD`, or `None` for a detached `HEAD`.",
          "type": [
            "string",
            "null"
          ]
        },
        "changes": {
          "anyOf": [
            {
              "$ref": "#/$defs/ChangeTotals"
            },
            {
              "type": "null"
            }
          ],
          "description": "The totals of the last count of the changes, or `None` before the first count."
        },
        "commit": {
          "description": "The short hash of `HEAD`, or `None` before the first commit.",
          "type": [
            "string",
            "null"
          ]
        },
        "diff_stats": {
          "anyOf": [
            {
              "$ref": "#/$defs/DiffStats"
            },
            {
              "type": "null"
            }
          ],
          "description": "The lines of all changed files."
        },
        "error": {
          "description": "Why the last look at the branches and the worktrees failed. The other values are those\nof the look before.",
          "type": [
            "string",
            "null"
          ]
        },
        "fetch_note": {
          "description": "Why the last fetch in the background failed, for example \"The fetch needs your\npassphrase. Click Fetch.\". A fetch that works clears it.",
          "type": [
            "string",
            "null"
          ]
        },
        "fetched_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ],
          "description": "The time of the last fetch, from `FETCH_HEAD`."
        },
        "fetched_text": {
          "description": "For example \"Last fetched 18 minutes ago\" or \"Never fetched\". `None` without a remote.",
          "type": [
            "string",
            "null"
          ]
        },
        "folder": {
          "description": "The folder that the window named.",
          "type": "string"
        },
        "job": {
          "anyOf": [
            {
              "$ref": "#/$defs/GitJob"
            },
            {
              "type": "null"
            }
          ],
          "description": "The fetch or the pull that runs in the repository."
        },
        "remote": {
          "description": "The remote of a fetch: the remote of the upstream, else `origin`, else the first one.",
          "type": [
            "string",
            "null"
          ]
        },
        "repo": {
          "description": "The key of the repository in `git_repos`: its common git directory.",
          "type": [
            "string",
            "null"
          ]
        },
        "repo_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "stash": {
          "anyOf": [
            {
              "$ref": "#/$defs/GitStash"
            },
            {
              "type": "null"
            }
          ],
          "description": "The stash that a switch left for the branch of `HEAD`, the newest one."
        },
        "trust": {
          "anyOf": [
            {
              "$ref": "#/$defs/GitTrustAsk"
            },
            {
              "type": "null"
            }
          ],
          "description": "The core runs no git command in the repository until the person trusts it. Then the\nhead has the worktree and the repository, and no branch, no count and no rows."
        },
        "upstream": {
          "description": "The upstream of the branch, for example `origin/main`.",
          "type": [
            "string",
            "null"
          ]
        },
        "upstream_gone": {
          "default": false,
          "description": "The upstream is gone from its remote.",
          "type": "boolean"
        },
        "worktree": {
          "description": "The root of the worktree that holds the folder, or `None` when the folder is not in a\ngit worktree.",
          "type": [
            "string",
            "null"
          ]
        },
        "worktree_name": {
          "description": "The last part of the root of the worktree.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "folder"
      ],
      "type": "object"
    },
    "GitJob": {
      "description": "The job of `git.fetch` or `git.pull` that runs. The `jobs` projection has its progress.",
      "properties": {
        "job": {
          "$ref": "#/$defs/JobId"
        },
        "kind": {
          "$ref": "#/$defs/GitJobKind"
        }
      },
      "required": [
        "kind",
        "job"
      ],
      "type": "object"
    },
    "GitJobKind": {
      "description": "A long command of git that runs in the worktree of a Git view.",
      "enum": [
        "fetch",
        "pull"
      ],
      "type": "string"
    },
    "GitLog": {
      "description": "`git.log`: the commits of `HEAD`, the newest first, in pages.",
      "properties": {
        "limit": {
          "default": 200,
          "description": "The most commits of the page, at most 200.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "path": {
          "description": "The worktree that holds this absolute path. The CLI gives the current directory.",
          "type": [
            "string",
            "null"
          ]
        },
        "skip": {
          "default": 0,
          "description": "The commits to leave out at the start: the number that the pages before had.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "window": {
          "anyOf": [
            {
              "$ref": "#/$defs/WindowId"
            },
            {
              "type": "null"
            }
          ],
          "description": "The worktree that the Git view of this window shows."
        }
      },
      "type": "object"
    },
    "GitLogResult": {
      "properties": {
        "commits": {
          "items": {
            "$ref": "#/$defs/GitCommit"
          },
          "type": "array"
        },
        "head": {
          "description": "The commit of `HEAD` when the page was read. Another value than the page before means\nthat the history changed: read it again from the start.",
          "type": [
            "string",
            "null"
          ]
        },
        "more": {
          "description": "More commits follow this page.",
          "type": "boolean"
        }
      },
      "required": [
        "commits",
        "more"
      ],
      "type": "object"
    },
    "GitPlace": {
      "description": "The worktree of a read: the one that the Git view of `window` follows, or the one that\nholds `path`.",
      "properties": {
        "path": {
          "description": "The worktree that holds this absolute path. The CLI gives the current directory.",
          "type": [
            "string",
            "null"
          ]
        },
        "window": {
          "anyOf": [
            {
              "$ref": "#/$defs/WindowId"
            },
            {
              "type": "null"
            }
          ],
          "description": "The worktree that the Git view of this window shows."
        }
      },
      "type": "object"
    },
    "GitPull": {
      "description": "`git.pull`: moves the branch to its upstream with a fast-forward only, as a job. A branch\nthat has commits of its own and is behind is `conflict` with `{\"kind\": \"diverged\"}`.",
      "properties": {
        "force": {
          "default": false,
          "description": "Pull also when an agent works in the worktree.",
          "type": "boolean"
        },
        "path": {
          "description": "The worktree that holds this absolute path. The CLI gives the current directory.",
          "type": [
            "string",
            "null"
          ]
        },
        "window": {
          "anyOf": [
            {
              "$ref": "#/$defs/WindowId"
            },
            {
              "type": "null"
            }
          ],
          "description": "The worktree that the Git view of this window shows."
        }
      },
      "type": "object"
    },
    "GitRepoAdd": {
      "description": "`git.repo_add`: `git_repos` keeps the repository that holds `path`, also when no workspace\nand no pane is in it.",
      "properties": {
        "path": {
          "description": "An absolute path in a git worktree.",
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "type": "object"
    },
    "GitRepoAdded": {
      "description": "The payload of `git.repo_added`: `git_repos` keeps a repository that the person added.",
      "properties": {
        "common_dir": {
          "description": "The common git directory of the repository.",
          "type": "string"
        },
        "path": {
          "description": "The path that the person gave.",
          "type": "string"
        }
      },
      "required": [
        "path",
        "common_dir"
      ],
      "type": "object"
    },
    "GitRepoList": {
      "description": "The rows of `git_repos`, in their order.",
      "properties": {
        "repos": {
          "items": {
            "$ref": "#/$defs/GitRepoValue"
          },
          "type": "array"
        }
      },
      "required": [
        "repos"
      ],
      "type": "object"
    },
    "GitRepoSource": {
      "description": "Where the core found a repository of `git_repos`.",
      "oneOf": [
        {
          "const": "workspace",
          "description": "The root of a workspace is in it.",
          "type": "string"
        },
        {
          "const": "pane",
          "description": "The folder of a pane is in it.",
          "type": "string"
        },
        {
          "const": "added",
          "description": "The person added it (`git.repo_add`).",
          "type": "string"
        }
      ]
    },
    "GitRepoValue": {
      "description": "`git_repos`: a git repository of this machine. The key is `common_dir`. The core fills it\nonly while a client follows it. The rows with agents come first, then by name.",
      "properties": {
        "agents": {
          "description": "The live agents whose pane folder is in a worktree of the repository.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "common_dir": {
          "description": "The git directory that the worktrees of the repository share.",
          "type": "string"
        },
        "name": {
          "description": "The name of the folder of the main worktree.",
          "type": "string"
        },
        "root": {
          "description": "The worktree that the Git view opens: the main one, or the one where the core found\nthe repository when the main one has no files (a bare repository).",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/GitRepoSource"
        }
      },
      "required": [
        "name",
        "common_dir",
        "root",
        "source",
        "agents"
      ],
      "type": "object"
    },
    "GitShow": {
      "description": "`git.show`: one commit with its message and its files.",
      "properties": {
        "commit": {
          "description": "The full or the short hash of the commit.",
          "type": "string"
        },
        "path": {
          "description": "The worktree that holds this absolute path. The CLI gives the current directory.",
          "type": [
            "string",
            "null"
          ]
        },
        "window": {
          "anyOf": [
            {
              "$ref": "#/$defs/WindowId"
            },
            {
              "type": "null"
            }
          ],
          "description": "The worktree that the Git view of this window shows."
        }
      },
      "required": [
        "commit"
      ],
      "type": "object"
    },
    "GitShown": {
      "properties": {
        "body": {
          "description": "The message after the subject, without the blank line between them.",
          "type": "string"
        },
        "commit": {
          "$ref": "#/$defs/GitCommit"
        },
        "email": {
          "description": "The e-mail address of the author.",
          "type": "string"
        },
        "files": {
          "description": "The changed files, in the byte order of the path. `stamp` is 0.",
          "items": {
            "$ref": "#/$defs/ChangeRow"
          },
          "type": "array"
        },
        "parents": {
          "description": "The short hashes of the parents. A merge has two or more. The files are the changes\nfrom the first parent.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "stats": {
          "$ref": "#/$defs/DiffStats",
          "description": "The lines of all files."
        },
        "truncated": {
          "default": false,
          "description": "The commit has more than 1,000 files, and `files` has the first 1,000.",
          "type": "boolean"
        }
      },
      "required": [
        "commit",
        "email",
        "body",
        "parents",
        "files",
        "stats"
      ],
      "type": "object"
    },
    "GitStash": {
      "description": "A stash that a switch with `leave` made for a branch.",
      "properties": {
        "branch": {
          "type": "string"
        },
        "commit": {
          "description": "The commit of the stash, for `git.unstash`.",
          "type": "string"
        },
        "time_text": {
          "description": "For example \"3 hours ago\".",
          "type": "string"
        }
      },
      "required": [
        "commit",
        "branch",
        "time_text"
      ],
      "type": "object"
    },
    "GitStatus": {
      "description": "`git.status`: the head and the changed files of a worktree, as `git_head:<window>` and\n`git_changes:<window>` have them.",
      "properties": {
        "changes": {
          "items": {
            "$ref": "#/$defs/ChangeRow"
          },
          "type": "array"
        },
        "head": {
          "$ref": "#/$defs/GitHead"
        }
      },
      "required": [
        "head",
        "changes"
      ],
      "type": "object"
    },
    "GitSwitch": {
      "description": "`git.switch`: the worktree goes to another branch. A worktree with changes needs\n`changes`, else the answer is `confirm_required` with `{\"kind\": \"changes\", \"files\"}`. A\nbranch that another worktree has out is `conflict` with `{\"kind\": \"worktree\", \"worktree\"}`.",
      "properties": {
        "branch": {
          "description": "A branch of `git_branches`: its reference (`refs/heads/main`) or its name (`main`,\n`origin/topic`). A remote branch with no local branch of the same name gets a local\nbranch that tracks it.",
          "type": "string"
        },
        "changes": {
          "anyOf": [
            {
              "$ref": "#/$defs/GitChanges"
            },
            {
              "type": "null"
            }
          ],
          "description": "What happens to the changes of the worktree: `bring` or `leave`. A worktree with\nchanges needs it."
        },
        "force": {
          "default": false,
          "description": "Switch also when an agent works in the worktree.",
          "type": "boolean"
        },
        "path": {
          "description": "The worktree that holds this absolute path. The CLI gives the current directory.",
          "type": [
            "string",
            "null"
          ]
        },
        "window": {
          "anyOf": [
            {
              "$ref": "#/$defs/WindowId"
            },
            {
              "type": "null"
            }
          ],
          "description": "The worktree that the Git view of this window shows."
        }
      },
      "required": [
        "branch"
      ],
      "type": "object"
    },
    "GitTrust": {
      "description": "`git.trust`: the person trusts the git repository that holds `path`. The core then runs git\nin it and in its worktrees. It keeps the settings of the repository that name a program,\nand asks again when they change. A trust again keeps the settings of now.",
      "properties": {
        "path": {
          "description": "An absolute path in a git worktree, for example `path` of `trust`.",
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "type": "object"
    },
    "GitTrustAsk": {
      "description": "`trust` of `changes_head` and `git_head`: the settings of a repository can name programs\nthat git runs, so the core runs git in a repository only after the person trusts it\n(`git.trust`).",
      "properties": {
        "changed": {
          "description": "The keys of the settings that changed after the trust, for example `core.fsmonitor`.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "common_dir": {
          "description": "The common git directory: the key of the trust, which its worktrees share.",
          "type": "string"
        },
        "path": {
          "description": "The root of the worktree that holds the folder. `git.trust` takes it.",
          "type": "string"
        },
        "reason": {
          "$ref": "#/$defs/GitTrustReason"
        }
      },
      "required": [
        "path",
        "common_dir",
        "reason"
      ],
      "type": "object"
    },
    "GitTrustEvent": {
      "description": "The payload of `git.trusted` and `git.untrusted`: the person trusts a repository, or takes\nthe trust back.",
      "properties": {
        "common_dir": {
          "description": "The common git directory of the repository: the key of the trust.",
          "type": "string"
        },
        "path": {
          "description": "The path that the person gave.",
          "type": "string"
        }
      },
      "required": [
        "path",
        "common_dir"
      ],
      "type": "object"
    },
    "GitTrustReason": {
      "description": "Why the core runs no git command in a repository.",
      "oneOf": [
        {
          "const": "new",
          "description": "The person did not trust the repository, or took the trust back.",
          "type": "string"
        },
        {
          "const": "changed",
          "description": "A setting of the repository that names a program changed after the trust.",
          "type": "string"
        }
      ]
    },
    "GitTrustResult": {
      "description": "The repository of `git.trust` or `git.untrust`.",
      "properties": {
        "common_dir": {
          "description": "The common git directory: the key of the trust, which its worktrees share.",
          "type": "string"
        },
        "root": {
          "description": "The root of the worktree that holds the path.",
          "type": "string"
        }
      },
      "required": [
        "root",
        "common_dir"
      ],
      "type": "object"
    },
    "GitUnstash": {
      "description": "`git.unstash`: puts the changes of a stash back into the worktree, and drops the stash.",
      "properties": {
        "force": {
          "default": false,
          "description": "Put the changes back also when an agent works in the worktree.",
          "type": "boolean"
        },
        "path": {
          "description": "The worktree that holds this absolute path. The CLI gives the current directory.",
          "type": [
            "string",
            "null"
          ]
        },
        "stash": {
          "description": "The commit of the stash, as `stash` of `git_head` gives it.",
          "type": "string"
        },
        "window": {
          "anyOf": [
            {
              "$ref": "#/$defs/WindowId"
            },
            {
              "type": "null"
            }
          ],
          "description": "The worktree that the Git view of this window shows."
        }
      },
      "required": [
        "stash"
      ],
      "type": "object"
    },
    "GitUntrust": {
      "description": "`git.untrust`: the person takes back the trust of the git repository that holds `path`.\nThe core runs no git command in it until the person trusts it again.",
      "properties": {
        "path": {
          "description": "An absolute path in a git worktree.",
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "type": "object"
    },
    "GitWorktreeList": {
      "description": "The rows of `git_worktrees:<window>` for a worktree, in their order.",
      "properties": {
        "worktrees": {
          "items": {
            "$ref": "#/$defs/GitWorktreeValue"
          },
          "type": "array"
        }
      },
      "required": [
        "worktrees"
      ],
      "type": "object"
    },
    "GitWorktreeValue": {
      "description": "`git_worktrees:<window>`: a worktree of the repository of the Git view. The key is\n`path`. The main worktree comes first, then the others in the order of git.",
      "properties": {
        "agents": {
          "items": {
            "$ref": "#/$defs/GitAgent"
          },
          "type": "array"
        },
        "branch": {
          "description": "The branch of the worktree, or `None` for a detached `HEAD`.",
          "type": [
            "string",
            "null"
          ]
        },
        "commit": {
          "description": "The short hash of its `HEAD`.",
          "type": [
            "string",
            "null"
          ]
        },
        "current": {
          "default": false,
          "description": "The worktree that the Git view shows.",
          "type": "boolean"
        },
        "dirty": {
          "description": "The files that are not committed, or `None` when the core could not count them.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "locked": {
          "default": false,
          "type": "boolean"
        },
        "main": {
          "default": false,
          "description": "The main worktree of the repository.",
          "type": "boolean"
        },
        "name": {
          "description": "The last part of the path.",
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "prunable": {
          "default": false,
          "description": "The folder of the worktree is gone, and `git worktree prune` would remove it.",
          "type": "boolean"
        }
      },
      "required": [
        "path",
        "name"
      ],
      "type": "object"
    },
    "GitWrite": {
      "description": "The payload of `git.switched`, `git.unstashed`, `git.fetched` and `git.pulled`: a write of\nthe Git view that worked. A write that failed appends no event.",
      "properties": {
        "agents": {
          "description": "The agents in the worktree at that time.",
          "items": {
            "$ref": "#/$defs/RunId"
          },
          "type": "array"
        },
        "background": {
          "default": false,
          "description": "The fetch ran in the background, not from a click.",
          "type": "boolean"
        },
        "command": {
          "description": "The git command, for example `git switch --end-of-options main`.",
          "type": "string"
        },
        "from": {
          "description": "The branch before a switch.",
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "description": "The worktree, or the common git directory for a fetch.",
          "type": "string"
        },
        "stash": {
          "description": "The stash that a switch made or that `git.unstash` put back.",
          "type": [
            "string",
            "null"
          ]
        },
        "to": {
          "description": "The branch after a switch or a pull.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "path",
        "command"
      ],
      "type": "object"
    },
    "GroupClose": {
      "description": "Closing a group keeps its workspaces. They have no group afterwards.",
      "properties": {
        "group": {
          "$ref": "#/$defs/RefGroupId"
        }
      },
      "required": [
        "group"
      ],
      "type": "object"
    },
    "GroupCreate": {
      "properties": {
        "name": {
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "GroupCreated": {
      "properties": {
        "group": {
          "$ref": "#/$defs/GroupId"
        }
      },
      "required": [
        "group"
      ],
      "type": "object"
    },
    "GroupEvent": {
      "description": "The payload of the `group.*` events.",
      "properties": {
        "group": {
          "$ref": "#/$defs/GroupId"
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "group"
      ],
      "type": "object"
    },
    "GroupId": {
      "description": "The ULID of a group of workspaces, as 26 characters.",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
      "type": "string"
    },
    "GroupList": {
      "type": "object"
    },
    "GroupListResult": {
      "properties": {
        "groups": {
          "items": {
            "$ref": "#/$defs/GroupSummary"
          },
          "type": "array"
        }
      },
      "required": [
        "groups"
      ],
      "type": "object"
    },
    "GroupMove": {
      "properties": {
        "before": {
          "anyOf": [
            {
              "$ref": "#/$defs/RefGroupId"
            },
            {
              "type": "null"
            }
          ],
          "description": "Put it before this group. Without it the group goes to the end."
        },
        "group": {
          "$ref": "#/$defs/RefGroupId"
        }
      },
      "required": [
        "group"
      ],
      "type": "object"
    },
    "GroupRef": {
      "description": "The group of a workspace in the sidebar.",
      "properties": {
        "id": {
          "$ref": "#/$defs/GroupId"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "type": "object"
    },
    "GroupRename": {
      "properties": {
        "group": {
          "$ref": "#/$defs/RefGroupId"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "group",
        "name"
      ],
      "type": "object"
    },
    "GroupShow": {
      "properties": {
        "group": {
          "$ref": "#/$defs/RefGroupId"
        }
      },
      "required": [
        "group"
      ],
      "type": "object"
    },
    "GroupSummary": {
      "properties": {
        "id": {
          "$ref": "#/$defs/GroupId"
        },
        "name": {
          "type": "string"
        },
        "workspaces": {
          "items": {
            "$ref": "#/$defs/WorkspaceId"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "workspaces"
      ],
      "type": "object"
    },
    "Harness": {
      "description": "The two harnesses of v1.",
      "enum": [
        "claude",
        "codex"
      ],
      "type": "string"
    },
    "HarnessChoices": {
      "properties": {
        "available": {
          "description": "A start with this harness can go on: it is installed and not logged out.",
          "type": "boolean"
        },
        "efforts": {
          "description": "The effort levels for the default model and for a model without its own levels. Empty:\nthe harness takes no effort level.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "harness": {
          "$ref": "#/$defs/Harness"
        },
        "hint": {
          "description": "What the person can do when the harness is not available.",
          "type": [
            "string",
            "null"
          ]
        },
        "installed": {
          "description": "The program of the harness is on the `PATH` of this machine.",
          "type": "boolean"
        },
        "login": {
          "$ref": "#/$defs/LoginState"
        },
        "models": {
          "description": "The models, in the order of the menu. The default of the harness is not in the list:\na launch without a model gets it.",
          "items": {
            "$ref": "#/$defs/ModelChoice"
          },
          "type": "array"
        }
      },
      "required": [
        "harness",
        "models",
        "efforts",
        "installed",
        "login",
        "available"
      ],
      "type": "object"
    },
    "HarnessManifestLoaded": {
      "properties": {
        "id": {
          "type": "string"
        },
        "serial": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "source": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "source",
        "serial"
      ],
      "type": "object"
    },
    "HarnessRefresh": {
      "description": "Finds the harnesses again and asks each one for its login state now. The call\nreturns when the probes are done, and the result is in the projection `harnesses`.",
      "properties": {
        "harness": {
          "description": "The id of one manifest, for example `codex`. Without it, every harness.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "HarnessValue": {
      "description": "`harnesses`: a harness that a manifest describes, as the core of this machine found it.\nThe key is the id of the manifest.",
      "properties": {
        "available": {
          "description": "A start of an agent with this harness can go on: the harness is installed and not\nlogged out.",
          "type": "boolean"
        },
        "checked_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ],
          "description": "The time of the last check."
        },
        "hint": {
          "description": "What the person can do: `[auth] login_hint` of the manifest, or why the program was not\nfound.",
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "installed": {
          "description": "The program of `[launch] argv` is on the `PATH` of the login environment.",
          "type": "boolean"
        },
        "login": {
          "$ref": "#/$defs/LoginState"
        },
        "login_method": {
          "anyOf": [
            {
              "$ref": "#/$defs/LoginMethod"
            },
            {
              "type": "null"
            }
          ]
        },
        "login_source": {
          "anyOf": [
            {
              "$ref": "#/$defs/LoginSource"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "type": "string"
        },
        "path": {
          "description": "The program that the core found.",
          "type": [
            "string",
            "null"
          ]
        },
        "validated": {
          "description": "The version is in a range of `[[capabilities]]` of the manifest.",
          "type": "boolean"
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "name",
        "installed",
        "validated",
        "login",
        "available"
      ],
      "type": "object"
    },
    "HealthFacet": {
      "properties": {
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "value": {
          "$ref": "#/$defs/AdapterHealth"
        }
      },
      "required": [
        "value",
        "provenance"
      ],
      "type": "object"
    },
    "HealthValue": {
      "description": "`health`: what the user needs to know about the core itself. It has one key, `_`.",
      "properties": {
        "holder_protocols": {
          "items": {
            "format": "uint16",
            "maximum": 65535,
            "minimum": 0,
            "type": "integer"
          },
          "type": "array"
        },
        "renderer": {
          "anyOf": [
            {
              "$ref": "#/$defs/RendererKind"
            },
            {
              "type": "null"
            }
          ]
        },
        "storage": {
          "$ref": "#/$defs/StorageHealth"
        },
        "unvalidated_harnesses": {
          "items": {
            "$ref": "#/$defs/UnvalidatedHarness"
          },
          "type": "array"
        },
        "warnings": {
          "items": {
            "$ref": "#/$defs/DoctorWarning"
          },
          "type": "array"
        }
      },
      "required": [
        "storage",
        "holder_protocols",
        "unvalidated_harnesses",
        "warnings"
      ],
      "type": "object"
    },
    "Hunk": {
      "properties": {
        "header": {
          "type": "string"
        },
        "lines": {
          "items": {
            "$ref": "#/$defs/DiffLine"
          },
          "type": "array"
        }
      },
      "required": [
        "header",
        "lines"
      ],
      "type": "object"
    },
    "InputStreamParams": {
      "properties": {
        "window": {
          "$ref": "#/$defs/WindowId"
        }
      },
      "required": [
        "window"
      ],
      "type": "object"
    },
    "IntegrationCapabilitiesParams": {
      "type": "object"
    },
    "IntegrationCapabilitiesResult": {
      "properties": {
        "rows": {
          "items": {
            "$ref": "#/$defs/CapabilityRow"
          },
          "type": "array"
        }
      },
      "required": [
        "rows"
      ],
      "type": "object"
    },
    "IntegrationChanges": {
      "properties": {
        "changes": {
          "items": {
            "$ref": "#/$defs/FileChange"
          },
          "type": "array"
        },
        "notes": {
          "description": "What the user must do, for example `/hooks` in Codex.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "changes",
        "notes"
      ],
      "type": "object"
    },
    "IntegrationDoctor": {
      "description": "Runs the round trip of `nh integration doctor`. It returns a job.",
      "properties": {
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/IntegrationTarget"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "IntegrationInfo": {
