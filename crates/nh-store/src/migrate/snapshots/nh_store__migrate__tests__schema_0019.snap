index workflow_executions_by_start on workflow_executions
    CREATE INDEX workflow_executions_by_start ON workflow_executions (started_at)

index workflow_nodes_by_run on workflow_nodes
    CREATE INDEX workflow_nodes_by_run ON workflow_nodes (run)

table agent_runs on agent_runs
    CREATE TABLE agent_runs (
        id TEXT PRIMARY KEY,
        pane_id TEXT REFERENCES panes (id) ON DELETE SET NULL,
        harness TEXT NOT NULL CHECK (harness IN ('claude', 'codex')),
        name TEXT UNIQUE,
        harness_session_id TEXT,
        previous_session_ids_json TEXT NOT NULL DEFAULT '[]',
        transcript_path TEXT,
        transcript_offset INTEGER NOT NULL DEFAULT 0,
        binding TEXT NOT NULL,
        binding_confidence REAL NOT NULL DEFAULT 1,
        launch_mode TEXT NOT NULL CHECK (launch_mode IN ('tui', 'headless')),
        version TEXT,
        capabilities_json TEXT NOT NULL DEFAULT '{}',
        facets_json TEXT NOT NULL DEFAULT '{}',
        yolo INTEGER NOT NULL DEFAULT 0,
        resume_json TEXT,
        model TEXT,
        started_at INTEGER NOT NULL,
        ended_at INTEGER,
        manifest TEXT,
        pid INTEGER,
        pid_start INTEGER,
        transcript_ledger_json TEXT,
        board_rank INTEGER
    ) STRICT

table blobs on blobs
    CREATE TABLE blobs (
        hash TEXT PRIMARY KEY,
        bytes INTEGER NOT NULL,
        mime TEXT NOT NULL,
        created_at INTEGER NOT NULL
    ) STRICT

table clients on clients
    CREATE TABLE clients (
        device TEXT PRIMARY KEY,
        name TEXT NOT NULL,
        last_seen INTEGER NOT NULL
    ) STRICT

table deliveries on deliveries
    CREATE TABLE deliveries (
        interaction_id TEXT PRIMARY KEY REFERENCES interactions (id) ON DELETE CASCADE,
        native_ref TEXT,
        decision_rev INTEGER NOT NULL DEFAULT 0,
        decision_json TEXT,
        decided_by TEXT,
        via TEXT,
        idempotency_key TEXT,
        channel TEXT CHECK (channel IN ('native', 'keystroke')),
        lease_json TEXT,
        deadline INTEGER,
        state TEXT NOT NULL,
        attempts_json TEXT NOT NULL DEFAULT '[]'
    ) STRICT

table drift on drift
    CREATE TABLE drift (
        harness TEXT NOT NULL,
        version TEXT NOT NULL,
        observations INTEGER NOT NULL DEFAULT 0,
        bad_signals INTEGER NOT NULL DEFAULT 0,
        raised INTEGER NOT NULL DEFAULT 0,
        PRIMARY KEY (harness, version)
    ) STRICT

table events on events
    CREATE TABLE events (
        seq INTEGER PRIMARY KEY AUTOINCREMENT,
        at INTEGER NOT NULL,
        kind TEXT NOT NULL,
        v INTEGER NOT NULL DEFAULT 1,
        subject TEXT,
        payload_json TEXT NOT NULL
    ) STRICT

table fingerprints on fingerprints
    CREATE TABLE fingerprints (
        fingerprint TEXT NOT NULL,
        decision TEXT NOT NULL CHECK (decision IN ('allow', 'deny')),
        interaction_id TEXT,
        at INTEGER NOT NULL,
        harness TEXT,
        tool TEXT,
        pattern TEXT,
        workspace TEXT,
        eligible INTEGER NOT NULL DEFAULT 0
    ) STRICT

table git_repos on git_repos
    CREATE TABLE git_repos (
        path TEXT PRIMARY KEY,
        added_at INTEGER NOT NULL
    ) STRICT

table git_trust on git_trust
    CREATE TABLE git_trust (
        common_dir TEXT PRIMARY KEY,
        settings TEXT NOT NULL,
        trusted_at INTEGER NOT NULL
    ) STRICT

table groups on groups
    CREATE TABLE groups (
        id TEXT PRIMARY KEY,
        name TEXT NOT NULL,
        parent_id TEXT REFERENCES groups (id) ON DELETE SET NULL,
        sort_key TEXT NOT NULL,
        created_at INTEGER NOT NULL,
        updated_at INTEGER NOT NULL
    ) STRICT

table handle_counters on handle_counters
    CREATE TABLE handle_counters (
        scope TEXT PRIMARY KEY,
        next INTEGER NOT NULL CHECK (next >= 1)
    ) STRICT

table interactions on interactions
    CREATE TABLE interactions (
        id TEXT PRIMARY KEY,
        handle TEXT NOT NULL UNIQUE,
        run_id TEXT REFERENCES agent_runs (id) ON DELETE SET NULL,
        pane_id TEXT REFERENCES panes (id) ON DELETE SET NULL,
        kind TEXT NOT NULL CHECK (kind IN ('approval', 'question', 'plan_review', 'notice')),
        native_ref TEXT,
        title TEXT NOT NULL,
        risk TEXT NOT NULL CHECK (risk IN ('low', 'medium', 'high', 'unknown')),
        payload_json TEXT NOT NULL,
        state TEXT NOT NULL CHECK (state IN ('open', 'decision_recorded', 'delivering', 'delivered', 'delivery_unknown', 'failed', 'superseded', 'resolved_elsewhere', 'dismissed', 'cancelled')),
        answerable INTEGER NOT NULL,
        gate_mode TEXT NOT NULL CHECK (gate_mode IN ('gate', 'observe')),
        source TEXT NOT NULL,
        confidence REAL NOT NULL,
        opened_at INTEGER NOT NULL,
        deadline INTEGER,
        resolved_at INTEGER,
        resolution_json TEXT,
        fingerprint TEXT
    ) STRICT

table meta on meta
    CREATE TABLE meta (
        key TEXT PRIMARY KEY,
        value TEXT NOT NULL
    ) STRICT

table notifications on notifications
    CREATE TABLE notifications (
        id TEXT PRIMARY KEY,
        text TEXT NOT NULL,
        urgency TEXT NOT NULL CHECK (urgency IN ('low', 'normal', 'high')),
        interaction_id TEXT REFERENCES interactions (id) ON DELETE SET NULL,
        run_id TEXT REFERENCES agent_runs (id) ON DELETE SET NULL,
        seen INTEGER NOT NULL DEFAULT 0,
        created_at INTEGER NOT NULL
    ) STRICT

table panes on panes
    CREATE TABLE panes (
        id TEXT PRIMARY KEY,
        render_id INTEGER NOT NULL,
        workspace_id TEXT REFERENCES workspaces (id) ON DELETE SET NULL,
        tab_id TEXT REFERENCES tabs (id) ON DELETE SET NULL,
        handle TEXT,
        pane_token TEXT,
        socket TEXT,
        holder_pid INTEGER,
        secret BLOB,
        fencing_token INTEGER,
        argv_json TEXT NOT NULL DEFAULT '[]',
        spec_json TEXT,
        cwd TEXT,
        cols INTEGER NOT NULL,
        rows INTEGER NOT NULL,
        liveness TEXT NOT NULL CHECK (liveness IN ('created', 'running', 'exited', 'lost')),
        exit_kind TEXT CHECK (exit_kind IN ('code', 'signal', 'exec_failed')),
        exit_value INTEGER,
        recovery_method TEXT,
        cleared_before_line INTEGER,
        last_archived_line INTEGER,
        clipboard_policy TEXT,
        created_at INTEGER NOT NULL,
        updated_at INTEGER NOT NULL
    ) STRICT

table phone_devices on phone_devices
    CREATE TABLE phone_devices (
        device TEXT PRIMARY KEY,
        name TEXT NOT NULL,
        token_hash TEXT NOT NULL UNIQUE,
        paired_at INTEGER NOT NULL,
        seen_at INTEGER,
        push_endpoint TEXT,
        push_p256dh TEXT,
        push_auth TEXT
    ) STRICT

table policy_rules on policy_rules
    CREATE TABLE policy_rules (
        id TEXT PRIMARY KEY,
        scope TEXT NOT NULL CHECK (scope IN ('config', 'session')),
        rule_json TEXT NOT NULL,
        source TEXT NOT NULL,
        created_at INTEGER NOT NULL
    ) STRICT

table projection_versions on projection_versions
    CREATE TABLE projection_versions (
        name TEXT PRIMARY KEY,
        version INTEGER NOT NULL DEFAULT 0
    ) STRICT

table scrollback_fts on scrollback_fts
    CREATE VIRTUAL TABLE scrollback_fts USING fts5 (
        text,
        pane_id UNINDEXED,
        line_no UNINDEXED
    )

table scrollback_fts_config on scrollback_fts_config
    CREATE TABLE 'scrollback_fts_config' (
        k PRIMARY KEY,
        v
    ) WITHOUT ROWID

table scrollback_fts_content on scrollback_fts_content
    CREATE TABLE 'scrollback_fts_content' (
        id INTEGER PRIMARY KEY,
        c0,
        c1,
        c2
    )

table scrollback_fts_data on scrollback_fts_data
    CREATE TABLE 'scrollback_fts_data' (
        id INTEGER PRIMARY KEY,
        block BLOB
    )

table scrollback_fts_docsize on scrollback_fts_docsize
    CREATE TABLE 'scrollback_fts_docsize' (
        id INTEGER PRIMARY KEY,
        sz BLOB
    )

table scrollback_fts_idx on scrollback_fts_idx
    CREATE TABLE 'scrollback_fts_idx' (
        segid,
        term,
        pgno,
        PRIMARY KEY (segid, term)
    ) WITHOUT ROWID

table scrollback_segments on scrollback_segments
    CREATE TABLE scrollback_segments (
        pane_id TEXT NOT NULL REFERENCES panes (id) ON DELETE CASCADE,
        segment_no INTEGER NOT NULL,
        first_line INTEGER NOT NULL,
        last_line INTEGER NOT NULL,
        path TEXT NOT NULL,
        bytes INTEGER NOT NULL,
        PRIMARY KEY (pane_id, segment_no)
    ) STRICT

table snapshots on snapshots
    CREATE TABLE snapshots (
        pane TEXT NOT NULL REFERENCES panes (id) ON DELETE CASCADE,
        offset INTEGER NOT NULL,
        created_at INTEGER NOT NULL,
        data BLOB NOT NULL,
        PRIMARY KEY (pane, offset)
    ) STRICT

table sqlite_sequence on sqlite_sequence
    CREATE TABLE sqlite_sequence (
        name,
        seq
    )

table tabs on tabs
    CREATE TABLE tabs (
        id TEXT PRIMARY KEY,
        workspace_id TEXT NOT NULL REFERENCES workspaces (id) ON DELETE CASCADE,
        handle TEXT NOT NULL UNIQUE,
        name TEXT NOT NULL,
        sort_key TEXT NOT NULL,
        layout_json TEXT NOT NULL,
        floating_json TEXT NOT NULL DEFAULT '[]',
        created_at INTEGER NOT NULL,
        updated_at INTEGER NOT NULL,
        zoomed_pane TEXT,
        hidden INTEGER NOT NULL DEFAULT 0
    ) STRICT

table usage on usage
    CREATE TABLE usage (
        run_id TEXT NOT NULL REFERENCES agent_runs (id) ON DELETE CASCADE,
        day TEXT NOT NULL,
        model TEXT NOT NULL,
        input INTEGER NOT NULL DEFAULT 0,
        output INTEGER NOT NULL DEFAULT 0,
        cache_read INTEGER NOT NULL DEFAULT 0,
        cache_write INTEGER NOT NULL DEFAULT 0,
        cost_usd REAL,
        PRIMARY KEY (run_id, day, model)
    ) STRICT

table windows on windows
    CREATE TABLE windows (
        id TEXT PRIMARY KEY,
        bounds_json TEXT,
        tab_by_workspace_json TEXT NOT NULL DEFAULT '{}',
        visible_panes_json TEXT NOT NULL DEFAULT '[]',
        focused_pane TEXT REFERENCES panes (id) ON DELETE SET NULL,
        open INTEGER NOT NULL DEFAULT 1,
        sort_key TEXT NOT NULL,
        created_at INTEGER NOT NULL,
        updated_at INTEGER NOT NULL,
        popout_pane TEXT REFERENCES panes (id) ON DELETE CASCADE,
        client TEXT
    ) STRICT

table workflow_executions on workflow_executions
    CREATE TABLE workflow_executions (
        id TEXT PRIMARY KEY,
        workflow TEXT NOT NULL,
        name TEXT NOT NULL,
        number INTEGER NOT NULL,
        folder TEXT NOT NULL,
        branch TEXT,
        base TEXT,
        head TEXT,
        tree TEXT,
        notes TEXT,
        graph TEXT NOT NULL,
        only_node TEXT,
        workspace TEXT,
        dir TEXT NOT NULL,
        state TEXT NOT NULL,
        tree_changed INTEGER NOT NULL DEFAULT 0,
        started_at INTEGER NOT NULL,
        ended_at INTEGER
    ) STRICT

table workflow_nodes on workflow_nodes
    CREATE TABLE workflow_nodes (
        execution TEXT NOT NULL REFERENCES workflow_executions (id) ON DELETE CASCADE,
        node TEXT NOT NULL,
        state TEXT NOT NULL,
        reason TEXT,
        run TEXT,
        verdict TEXT,
        report TEXT,
        turns INTEGER NOT NULL DEFAULT 0,
        started_at INTEGER,
        ended_at INTEGER,
        PRIMARY KEY (execution, node)
    ) STRICT

table workspaces on workspaces
    CREATE TABLE workspaces (
        id TEXT PRIMARY KEY,
        handle TEXT NOT NULL UNIQUE,
        name TEXT NOT NULL,
        root_path TEXT,
        machine TEXT NOT NULL DEFAULT 'local',
        group_id TEXT REFERENCES groups (id) ON DELETE SET NULL,
        sort_key TEXT NOT NULL,
        closed_at INTEGER,
        created_at INTEGER NOT NULL,
        updated_at INTEGER NOT NULL,
        selected_tab TEXT REFERENCES tabs (id) ON DELETE SET NULL
    ) STRICT

