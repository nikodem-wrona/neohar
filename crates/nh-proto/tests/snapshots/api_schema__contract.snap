            }
          },
          "required": [
            "state",
            "reason"
          ],
          "type": "object"
        }
      ]
    },
    "StreamKind": {
      "oneOf": [
        {
          "const": "render",
          "description": "Core to UI: frames for the visible panes of a window.",
          "type": "string"
        },
        {
          "const": "peek",
          "description": "Core to UI: downscaled keyframes for thumbnails and card context.",
          "type": "string"
        },
        {
          "const": "scrollback",
          "description": "Core to UI: styled lines from the archive, for the viewport beyond the in-memory grid.",
          "type": "string"
        },
        {
          "const": "input",
          "description": "UI to core: batched mouse motion. Keys always use `pane.input`.",
          "type": "string"
        }
      ]
    },
    "TabClose": {
