        },
        "question": {
          "type": "string"
        }
      },
      "required": [
        "question",
        "options"
      ],
      "type": "object"
    },
    "QuestionAnswer": {
      "properties": {
        "question": {
          "description": "The text of the question.",
          "type": "string"
        },
        "selected": {
          "description": "The labels of the chosen options.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "text": {
          "description": "Free text, when the user typed an answer.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "question",
        "selected"
      ],
      "type": "object"
    },
    "QuestionDecision": {
      "properties": {
        "answers": {
          "items": {
            "$ref": "#/$defs/QuestionAnswer"
          },
          "type": "array"
        }
      },
      "required": [
        "answers"
      ],
      "type": "object"
    },
    "QuestionOption": {
      "properties": {
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "label": {
          "type": "string"
        }
      },
      "required": [
        "label"
      ],
      "type": "object"
    },
    "QuestionPayload": {
      "properties": {
        "context": {
          "description": "The last message of the agent, as context.",
          "type": [
            "string",
            "null"
          ]
        },
        "questions": {
          "items": {
            "$ref": "#/$defs/Question"
          },
          "type": "array"
        }
      },
      "required": [
        "questions"
      ],
      "type": "object"
    },
    "RateLimitWindow": {
      "properties": {
        "name": {
          "type": "string"
        },
        "resets_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "used_percent": {
          "description": "From 0 to 100.",
          "format": "float",
          "type": "number"
        }
      },
      "required": [
        "name",
        "used_percent"
      ],
      "type": "object"
    },
    "ReadState": {
      "description": "The read state of the run for one client. The core keeps it for each subscription.",
      "enum": [
        "seen",
        "unseen"
      ],
      "type": "string"
    },
    "Rect": {
      "description": "A rectangle as fractions of the area of the tab, from 0 to 1. A floating pane has one.",
      "properties": {
        "h": {
          "format": "float",
          "type": "number"
        },
        "w": {
          "format": "float",
          "type": "number"
        },
        "x": {
          "format": "float",
          "type": "number"
        },
        "y": {
          "format": "float",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "w",
        "h"
      ],
      "type": "object"
    },
    "RefGroupId": {
      "description": "A reference to a group: its ULID.",
      "type": "string"
    },
    "RefInteractionId": {
      "description": "A reference to an interaction: its ULID, or its short handle.",
      "type": "string"
    },
    "RefPaneId": {
      "description": "A reference to a pane: its ULID, or its short handle.",
      "type": "string"
    },
    "RefRunId": {
      "description": "A reference to an agent run: its ULID, or its unique name.",
      "type": "string"
    },
    "RefTabId": {
      "description": "A reference to a tab: its ULID, or its short handle.",
      "type": "string"
    },
    "RefWorkspaceId": {
      "description": "A reference to a workspace: its ULID, or its short handle.",
      "type": "string"
    },
    "RenderAck": {
      "description": "`render.ack`. The UI sends it at most once for each painted animation frame, and only\nwhen something changed.",
      "properties": {
        "acks": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PaneAck"
          },
          "type": "array"
        },
        "need_keyframe": {
          "default": [],
          "description": "The panes whose frames the UI discarded. The core sends a keyframe for each.",
          "items": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "type": "array"
        },
        "window": {
          "$ref": "#/$defs/WindowId"
        }
      },
      "required": [
        "window"
      ],
      "type": "object"
    },
    "RenderParams": {
      "description": "Opens the `render` stream of a window.",
      "properties": {
        "proto": {
          "description": "The version of the frame format that the client decodes (`FRAME_PROTO`).",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "viewport_hz": {
          "description": "The refresh rate of the window.",
          "format": "float",
          "type": "number"
        },
        "window": {
          "$ref": "#/$defs/WindowId"
        }
      },
      "required": [
        "window",
        "viewport_hz",
        "proto"
      ],
      "type": "object"
    },
    "RendererKind": {
      "description": "Which renderer paints a window.",
      "enum": [
        "webgl2",
        "canvas2d"
      ],
      "type": "string"
    },
    "Request": {
      "description": "A request. A request without an `id` is a notification of the client, and gets no response.",
      "properties": {
        "id": {
          "anyOf": [
            {
              "$ref": "#/$defs/RequestId"
            },
            {
              "type": "null"
            }
          ]
        },
        "jsonrpc": {
          "$ref": "#/$defs/JsonRpc"
        },
        "method": {
          "type": "string"
        },
        "params": {
          "default": null
        }
      },
      "required": [
        "jsonrpc",
        "method"
      ],
      "type": "object"
    },
    "RequestId": {
      "anyOf": [
        {
          "format": "int64",
          "type": "integer"
        },
        {
          "type": "string"
        }
      ],
      "description": "The id of a request: a number or a string."
    },
    "Response": {
      "description": "A response. Exactly one of `result` and `error` is set. `id` is `null` when the request was too\nbroken to have one.",
      "properties": {
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/RpcError"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "anyOf": [
            {
              "$ref": "#/$defs/RequestId"
            },
            {
              "type": "null"
            }
          ]
        },
        "jsonrpc": {
          "$ref": "#/$defs/JsonRpc"
        },
        "result": true
      },
      "required": [
        "jsonrpc"
      ],
      "type": "object"
    },
    "Reveal": {
      "description": "A request to a window: show the inbox, and focus the card of this interaction.",
      "properties": {
        "interaction": {
          "$ref": "#/$defs/InteractionId"
        },
        "seq": {
          "description": "Grows with each request, so that the same interaction can be asked for twice.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "interaction",
        "seq"
      ],
      "type": "object"
    },
    "RichDiff": {
      "properties": {
        "a": {
          "type": "string"
        },
        "b": {
          "type": "string"
        },
        "lang": {
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "a",
        "b"
      ],
      "type": "object"
    },
    "RichHighlight": {
      "properties": {
        "lang": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "text",
        "lang"
      ],
      "type": "object"
    },
    "RichMarkdown": {
      "properties": {
        "text": {
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "type": "object"
    },
    "Risk": {
      "description": "How risky a command or an action is.",
      "enum": [
        "low",
        "medium",
        "high",
        "unknown"
      ],
      "type": "string"
    },
    "RpcError": {
      "description": "The `error` member of a response.",
      "properties": {
        "code": {
          "description": "The integer of JSON-RPC: a reserved one for a protocol error, else `-32000`.",
