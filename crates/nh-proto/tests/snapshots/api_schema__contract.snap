        "scope"
      ],
      "type": "object"
    },
    "PolicyList": {
      "type": "object"
    },
    "PolicyListResult": {
      "properties": {
        "rules": {
          "items": {
            "$ref": "#/$defs/PolicyRuleValue"
          },
          "type": "array"
        }
      },
      "required": [
        "rules"
      ],
      "type": "object"
    },
    "PolicyRemove": {
      "properties": {
        "id": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "PolicyRule": {
      "description": "A rule.",
      "properties": {
        "command": {
          "description": "For `Bash`: a prefix glob on the normalized command. `*` only at the end.",
          "type": [
            "string",
            "null"
          ]
        },
        "decision": {
          "$ref": "#/$defs/PolicyDecision"
        },
        "harness": {
          "description": "Default: any harness.",
          "items": {
            "$ref": "#/$defs/Harness"
          },
          "type": "array"
        },
        "id": {
          "description": "Made by the core if absent.",
          "type": [
            "string",
            "null"
          ]
        },
        "paths": {
          "description": "For file tools: globs relative to the workspace root.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "tool": {
          "description": "The exact name of the tool, or `*`.",
          "type": "string"
        },
        "workspace": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "decision",
        "tool"
      ],
      "type": "object"
    },
    "PolicyRuleValue": {
      "properties": {
        "created_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "id": {
          "type": "string"
        },
        "rule": {
          "$ref": "#/$defs/PolicyRule"
        },
        "scope": {
          "$ref": "#/$defs/PolicyScope"
        }
      },
      "required": [
        "id",
        "rule",
        "scope",
        "created_at"
      ],
      "type": "object"
    },
    "PolicyScope": {
      "oneOf": [
        {
          "const": "config",
          "description": "From the config file.",
          "type": "string"
        },
        {
          "const": "session",
          "description": "From \"Allow always\" in a card.",
          "type": "string"
        }
      ]
    },
    "PolicySuggest": {
      "type": "object"
    },
    "PolicySuggestResult": {
      "properties": {
        "suggestions": {
          "items": {
            "$ref": "#/$defs/PolicySuggestion"
          },
          "type": "array"
        }
      },
      "required": [
        "suggestions"
      ],
      "type": "object"
    },
    "PolicySuggestion": {
      "description": "A rule that the user could add: approved at least 5 times, never denied, in 30 days.",
      "properties": {
        "approvals": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "fingerprint": {
          "type": "string"
        },
        "last_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "rule": {
          "$ref": "#/$defs/PolicyRule"
        },
        "toml": {
          "description": "The rule as a `[[policy.rule]]` block, ready to paste into `config.toml`.",
          "type": "string"
        }
      },
      "required": [
        "rule",
        "toml",
        "fingerprint",
        "approvals",
        "last_at"
      ],
      "type": "object"
    },
    "PortForward": {
      "description": "A port that the client forwards to a machine.",
      "properties": {
        "local_port": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "remote_port": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "remote_port",
        "local_port"
      ],
      "type": "object"
    },
    "ProcessSpec": {
      "description": "What to run in a new pane. Without it the pane runs the login shell of the user.",
      "properties": {
        "argv": {
          "description": "The program and its arguments.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "cwd": {
          "type": [
            "string",
            "null"
          ]
        },
        "env": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Extra variables for the environment of the process.",
          "type": "object"
        }
      },
      "required": [
        "argv"
      ],
      "type": "object"
    },
    "Projection": {
      "description": "The name of a projection. timeline:<run>, pane_text:<pane>, agents_for:<window>, changes_for:<window>, changes_head:<window>, git_head:<window>, git_worktrees:<window>, git_branches:<window> and git_changes:<window> take an id.",
      "pattern": "^(windows|tree|panes|agents|attention|interactions|notifications|machines|harnesses|limits|jobs|palette|settings|phones|phone_pairing|phone_status|git_repos|health|link|timeline:[0-9A-HJKMNP-TV-Z]{26}|pane_text:[0-9A-HJKMNP-TV-Z]{26}|agents_for:[0-9A-HJKMNP-TV-Z]{26}|changes_for:[0-9A-HJKMNP-TV-Z]{26}|changes_head:[0-9A-HJKMNP-TV-Z]{26}|git_head:[0-9A-HJKMNP-TV-Z]{26}|git_worktrees:[0-9A-HJKMNP-TV-Z]{26}|git_branches:[0-9A-HJKMNP-TV-Z]{26}|git_changes:[0-9A-HJKMNP-TV-Z]{26})$",
      "type": "string"
    },
    "ProjectionData": {
      "description": "The state of a projection: the values by key, and the order of the keys.",
      "properties": {
        "items": {
          "additionalProperties": true,
          "type": "object"
        },
        "order": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "items",
        "order"
      ],
      "type": "object"
    },
    "ProjectionMessage": {
      "description": "What a subscription delivers: a snapshot once, then patches. `resync` means that\nthe client is older than the core retains, and it subscribes again.",
      "oneOf": [
        {
          "properties": {
            "data": {
              "$ref": "#/$defs/ProjectionData"
            },
            "type": {
              "const": "snapshot",
              "type": "string"
            },
            "version": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "type",
            "version",
            "data"
          ],
          "type": "object"
        },
        {
          "properties": {
            "ops": {
              "items": {
                "$ref": "#/$defs/PatchOp"
              },
              "type": "array"
            },
            "type": {
              "const": "patch",
              "type": "string"
            },
            "version": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "type",
            "version",
            "ops"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "const": "resync",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        }
      ]
    },
    "ProjectionNotification": {
      "description": "The params of the notification `projection.message`.",
      "properties": {
        "message": {
          "$ref": "#/$defs/ProjectionMessage"
        },
        "subscription": {
          "type": "string"
        }
      },
      "required": [
        "subscription",
        "message"
      ],
      "type": "object"
    },
    "ProjectionSubscribe": {
      "description": "`projection.subscribe`. Messages arrive as `projection.message` notifications.",
      "properties": {
        "name": {
          "$ref": "#/$defs/Projection"
        },
        "since": {
          "description": "The version the client has. The core sends only patches if it still retains them.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "ProjectionSubscribed": {
      "properties": {
        "subscription": {
          "type": "string"
        }
      },
      "required": [
        "subscription"
      ],
      "type": "object"
    },
    "ProjectionUnsubscribe": {
      "properties": {
        "subscription": {
          "type": "string"
        }
      },
      "required": [
        "subscription"
      ],
      "type": "object"
    },
    "ProjectionVersions": {
      "description": "`projection.versions {names}`: the version of each projection named. A client\ncompares them with the versions of its subscriptions, because a subscription can stop\nwithout a gap in its versions: a channel of the host can lose one message and hold the\nones after it, and the core drops a sink whose send fails.",
      "properties": {
        "names": {
          "items": {
            "$ref": "#/$defs/Projection"
          },
          "type": "array"
        }
      },
      "required": [
        "names"
      ],
      "type": "object"
    },
    "ProjectionVersionsResult": {
      "properties": {
        "versions": {
          "additionalProperties": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "description": "The version by name. A projection that the core has not made is left out.",
          "type": "object"
        }
      },
      "required": [
        "versions"
      ],
      "type": "object"
    },
    "Protocols": {
      "description": "The versions of the wire formats of this core.",
      "properties": {
        "frame": {
          "description": "`nh_proto::version::FRAME_PROTO`.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "holder": {
          "description": "`nh_proto::version::HOLDER_PROTO`.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "frame",
        "holder"
      ],
      "type": "object"
    },
    "Provenance": {
      "description": "Where a facet came from.",
      "properties": {
        "at": {
          "$ref": "#/$defs/Timestamp"
        },
        "confidence": {
          "description": "From 0 to 1.",
          "format": "float",
          "type": "number"
        },
        "source": {
          "$ref": "#/$defs/Source"
        }
      },
      "required": [
        "source",
        "confidence",
        "at"
      ],
      "type": "object"
    },
    "Question": {
      "properties": {
        "header": {
          "type": [
            "string",
