      "type": "object"
    },
    "SelectMode": {
      "enum": [
        "simple",
        "word",
        "line",
        "block"
      ],
      "type": "string"
    },
    "SelectPoint": {
      "description": "A cell in the scrollback: the column, and the absolute line.",
      "properties": {
