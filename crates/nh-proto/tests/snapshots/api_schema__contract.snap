        "pane"
      ],
      "type": "object"
    },
    "PaneValue": {
      "description": "`panes`: one pane.",
      "properties": {
        "alt_screen": {
          "default": false,
          "type": "boolean"
        },
        "bracketed_paste": {
          "default": false,
          "type": "boolean"
        },
        "clipboard_dropped": {
          "anyOf": [
            {
              "$ref": "#/$defs/ClipboardDropped"
            },
            {
              "type": "null"
            }
          ],
          "description": "The last OSC 52 write that no client got. The next write that a client gets clears it."
        },
        "clipboard_request": {
          "anyOf": [
            {
              "$ref": "#/$defs/ClipboardRequest"
            },
            {
              "type": "null"
            }
          ]
        },
        "cols": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "cwd": {
          "type": [
            "string",
            "null"
          ]
        },
        "fg_process": {
          "description": "The foreground process.",
          "type": [
            "string",
            "null"
          ]
        },
        "geometry_owner": {
          "anyOf": [
            {
              "$ref": "#/$defs/WindowId"
            },
            {
              "type": "null"
            }
          ],
          "description": "The window whose size the PTY follows."
        },
        "handle": {
          "description": "The short handle, for example `w3:p5`.",
          "type": "string"
        },
        "id": {
          "$ref": "#/$defs/PaneId"
        },
        "input_unconfirmed": {
          "description": "Inputs that were in flight when something went away (`pane.input_unconfirmed`).",
          "items": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "type": "array"
        },
        "liveness": {
          "$ref": "#/$defs/PaneLiveness"
        },
        "mouse_mode": {
          "$ref": "#/$defs/MouseMode"
        },
        "render_id": {
          "description": "The number that frames carry for this pane.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "restoring": {
          "default": false,
          "description": "The pane shows the restored screen and the holder has not caught up.",
          "type": "boolean"
        },
        "rows": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "run": {
          "anyOf": [
            {
              "$ref": "#/$defs/RunId"
            },
            {
              "type": "null"
            }
          ],
          "description": "The run of an agent in the pane."
        },
        "tab": {
          "$ref": "#/$defs/TabId"
        },
        "title": {
          "type": "string"
        },
        "workspace": {
          "$ref": "#/$defs/WorkspaceId"
        }
      },
      "required": [
        "id",
        "handle",
        "render_id",
        "workspace",
        "tab",
        "title",
        "cols",
        "rows",
        "liveness",
        "mouse_mode"
      ],
      "type": "object"
    },
    "PatchOp": {
      "description": "One change of a patch.",
      "oneOf": [
        {
          "description": "Sets the value of a key. The key is new or it exists.",
          "properties": {
            "key": {
              "type": "string"
            },
            "op": {
              "const": "set",
              "type": "string"
            },
            "value": true
          },
          "required": [
            "op",
            "key",
            "value"
          ],
          "type": "object"
        },
        {
          "properties": {
            "key": {
              "type": "string"
            },
            "op": {
              "const": "remove",
              "type": "string"
            }
          },
          "required": [
            "op",
            "key"
          ],
          "type": "object"
        },
        {
          "description": "Sets the order of all keys.",
          "properties": {
            "keys": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "op": {
              "const": "order",
              "type": "string"
            }
          },
          "required": [
            "op",
            "keys"
          ],
          "type": "object"
        }
      ]
    },
    "PeekParams": {
      "description": "Opens the `peek` stream of a pane. A keyframe holds the bottom `max_rows` rows and\nthe left `max_cols` columns.",
      "properties": {
        "max_cols": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "max_hz": {
          "default": 4.0,
          "format": "float",
          "type": "number"
        },
        "max_rows": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "pane": {
          "$ref": "#/$defs/RefPaneId"
        }
      },
      "required": [
        "pane",
        "max_cols",
        "max_rows"
      ],
      "type": "object"
    },
    "PhoneEvent": {
      "description": "The payload of `phone.paired`, `phone.renamed` and `phone.removed`. The\nevent never holds a code or a token.",
      "properties": {
        "device": {
          "$ref": "#/$defs/DeviceId"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "device",
        "name"
      ],
      "type": "object"
    },
    "PhonePairBegin": {
      "description": "`phone.pair_begin`: a new offer of a pairing. It ends the offer before it.",
      "type": "object"
    },
    "PhonePairStarted": {
      "description": "The offer, also in the projection `phone_pairing`. The result has data so that the CLI can\nprint the URL and the short code.",
      "properties": {
        "code": {
          "type": "string"
        },
        "expires_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "url",
        "code",
        "expires_at"
      ],
      "type": "object"
    },
    "PhonePairingValue": {
      "description": "`phone_pairing`: the offer of a pairing. It has one key, `_`. A phone cannot\nfollow it, because it holds the codes.",
      "properties": {
        "code": {
          "description": "The short code that a person types: 8 Crockford base32 characters, as `ABCD-EFGH`.",
          "type": [
            "string",
            "null"
          ]
        },
        "device": {
          "anyOf": [
            {
              "$ref": "#/$defs/DeviceId"
            },
            {
              "type": "null"
            }
          ],
          "description": "The phone that paired with the offer."
        },
        "expires_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ],
          "description": "When the offer ends."
        },
        "note": {
          "description": "The time that the offer is good for, as a person reads it, for example \"The code is\ngood for 10 minutes and for one phone.\". The page shows it as it is.",
          "type": [
            "string",
            "null"
          ]
        },
        "qr": {
          "description": "The QR code of `url` as an SVG `data:` URL. The page shows it in an image.",
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "$ref": "#/$defs/PairingState"
        },
        "url": {
          "description": "The URL of the QR code: the public origin, `/pair?code=` and the long code.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "state"
      ],
      "type": "object"
    },
    "PhonePushFailed": {
      "description": "The payload of `phone.push_failed`: a push of a run did not reach the push\nservice of a phone.",
      "properties": {
        "device": {
          "$ref": "#/$defs/DeviceId"
        },
        "status": {
          "description": "The last status of the push service. `None` when no answer came.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "device"
      ],
      "type": "object"
    },
    "PhonePushSubscribe": {
      "description": "`phone.push_subscribe`: the push subscription of the phone that calls. Only a\nphone calls it, for itself. A new subscription replaces the old one.",
      "properties": {
        "auth": {
          "description": "The authentication secret of the browser (16 bytes), base64url.",
          "type": "string"
        },
        "endpoint": {
          "description": "The endpoint of the push service. It must be on the allowlist of push services.",
          "type": "string"
        },
        "p256dh": {
          "description": "The public key of the browser (P-256, uncompressed), base64url.",
          "type": "string"
        }
      },
      "required": [
        "endpoint",
        "p256dh",
        "auth"
      ],
      "type": "object"
    },
    "PhonePushTest": {
      "description": "`phone.push_test`: sends the push \"Test notification\" to a phone.",
      "properties": {
        "device": {
          "$ref": "#/$defs/DeviceId"
        }
      },
      "required": [
        "device"
      ],
      "type": "object"
    },
    "PhonePushed": {
      "description": "The payload of `phone.pushed`: the push service took a push of a run\nfor a phone. The event holds the reason, never the text of the push.",
      "properties": {
        "device": {
          "$ref": "#/$defs/DeviceId"
        },
        "reason": {
          "$ref": "#/$defs/AttentionReason"
        },
        "run": {
          "$ref": "#/$defs/RunId"
        }
      },
      "required": [
        "device",
        "run",
        "reason"
      ],
      "type": "object"
    },
    "PhoneRemove": {
      "description": "`phone.remove`: removes a paired phone, closes its connections and its streams, and removes\nits phone windows.",
      "properties": {
        "device": {
          "$ref": "#/$defs/DeviceId"
        }
      },
      "required": [
        "device"
      ],
      "type": "object"
    },
    "PhoneRename": {
      "description": "`phone.rename`: the name of a paired phone.",
      "properties": {
        "device": {
          "$ref": "#/$defs/DeviceId"
        },
        "name": {
          "description": "1 to 64 characters.",
          "type": "string"
        }
      },
      "required": [
        "device",
        "name"
      ],
      "type": "object"
    },
    "PhoneReplied": {
      "description": "The payload of `phone.replied`: a phone sent `agent.reply` to a run. The event\ndoes not hold the text.",
      "properties": {
        "device": {
          "$ref": "#/$defs/DeviceId"
        },
        "run": {
          "$ref": "#/$defs/RunId"
        }
      },
      "required": [
        "device",
        "run"
      ],
      "type": "object"
    },
    "PhoneStatusValue": {
      "description": "`phone_status`: the listener of the phone. It has one key, `_`.",
      "properties": {
        "hint": {
          "description": "What the person can do when the listener cannot serve a phone. `phone.pair_begin`\nrefuses while there is a hint.",
          "type": [
            "string",
            "null"
          ]
        },
        "listening": {
          "description": "Whether the listener serves its port.",
          "type": "boolean"
        },
        "origin": {
          "description": "The HTTPS origin that a phone uses, for example `https://studio.example.ts.net:8443`.",
          "type": [
            "string",
            "null"
          ]
        },
        "port": {
          "description": "The port of `127.0.0.1`, when the listener has one.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "summary": {
          "default": "",
          "description": "One line about the listener, for the settings window and the doctor, for example\n\"Published with Tailscale at https://studio.example.ts.net:8443.\".",
          "type": "string"
        },
        "tailscale": {
          "anyOf": [
            {
              "$ref": "#/$defs/TailscaleStatus"
            },
            {
              "type": "null"
            }
          ],
          "description": "Tailscale. `null` when the listener does not use it: the listener is\noff, `phone.url` names the origin, or the run is a development run."
        },
        "vapid_key": {
          "description": "The public VAPID key of this core: the uncompressed P-256 point, base64url.\nThe phone app subscribes to push with it. `null` while the listener does not run.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "listening"
      ],
      "type": "object"
    },
    "PhoneValue": {
      "description": "`phones`: a paired phone. The key is the device id. The core orders the\nrows, the phone paired last first.",
      "properties": {
        "device": {
          "$ref": "#/$defs/DeviceId"
        },
        "name": {
          "description": "The name that the phone gave when it paired, or that `phone.rename` set.",
          "type": "string"
        },
        "paired_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "push": {
          "default": false,
          "description": "Whether the phone has a push subscription.",
          "type": "boolean"
        },
        "seen_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ],
          "description": "The time of the last connection of the phone, or `null` before the first one."
        }
      },
      "required": [
        "device",
        "name",
        "paired_at"
      ],
      "type": "object"
    },
    "PhoneVisible": {
      "description": "`phone.visible`: the phone app of the phone that calls is open and visible, or not.\nThe app calls it on each `visibilitychange`. A visible phone gets no push. The\ncore keeps it in memory for the connection, and the end of the connection makes it false.",
      "properties": {
        "visible": {
          "type": "boolean"
        }
      },
      "required": [
        "visible"
      ],
      "type": "object"
    },
    "PhoneWindowResult": {
      "description": "The result of `phone.window`: the phone window of the device that calls, on this core.\nThe core makes the row when the device has none.",
      "properties": {
        "window": {
          "$ref": "#/$defs/WindowId"
        }
      },
      "required": [
        "window"
      ],
      "type": "object"
    },
    "Placement": {
      "description": "Where an agent starts.",
      "oneOf": [
        {
          "description": "A new tab of the workspace.",
          "properties": {
            "type": {
              "const": "new_tab",
              "type": "string"
            },
            "workspace": {
              "$ref": "#/$defs/RefWorkspaceId"
            }
          },
          "required": [
            "type",
            "workspace"
          ],
          "type": "object"
        },
        {
          "description": "A new pane beside an existing one.",
          "properties": {
            "direction": {
              "$ref": "#/$defs/SplitDirection"
            },
            "pane": {
              "$ref": "#/$defs/RefPaneId"
            },
            "type": {
              "const": "split",
              "type": "string"
            }
          },
          "required": [
            "type",
            "pane",
            "direction"
          ],
          "type": "object"
        },
        {
          "description": "An existing pane whose shell is idle. The core types the command there.",
          "properties": {
            "pane": {
              "$ref": "#/$defs/RefPaneId"
            },
            "type": {
              "const": "pane",
              "type": "string"
            }
          },
          "required": [
            "type",
            "pane"
          ],
          "type": "object"
        }
      ]
    },
    "PlanDecision": {
      "properties": {
        "approve": {
          "type": "boolean"
        },
        "feedback": {
          "description": "With `approve: false`, the feedback becomes the deny message.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "approve"
      ],
      "type": "object"
    },
    "PlanPayload": {
      "properties": {
        "plan": {
          "$ref": "#/$defs/Markdown"
