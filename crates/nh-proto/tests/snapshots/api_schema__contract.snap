    "TailscaleState": {
      "description": "The state of the daemon of Tailscale.",
      "oneOf": [
        {
          "const": "missing",
          "description": "No `tailscale` on the `PATH` of the login environment and none in\n`/Applications/Tailscale.app`.",
          "type": "string"
        },
        {
          "const": "unreachable",
          "description": "The CLI gave no answer that the core understands, for example because the daemon\ndoes not run.",
          "type": "string"
        },
        {
          "const": "starting",
          "description": "The daemon starts.",
          "type": "string"
        },
        {
          "const": "stopped",
          "description": "The daemon is not connected to the tailnet.",
          "type": "string"
        },
        {
          "const": "needs_login",
          "description": "The daemon needs a login, or the admin of the tailnet must approve the machine.",
          "type": "string"
        },
        {
          "const": "running",
          "description": "The daemon is connected to the tailnet.",
          "type": "string"
        }
      ]
    },
    "TailscaleStatus": {
      "description": "What `tailscale status --json` and `tailscale serve status --json` say about the listener.",
      "properties": {
        "funnel": {
          "default": false,
          "description": "Whether a Funnel is on `https_port`. neohar never turns one on.",
          "type": "boolean"
        },
        "https": {
          "default": false,
          "description": "Whether the tailnet gives an HTTPS certificate for the name (`CertDomains`).",
          "type": "boolean"
        },
        "https_port": {
          "description": "The HTTPS port of the mapping: `phone.https_port`.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "name": {
          "description": "The name of this machine in the tailnet, without the dot at the end, for example\n`studio.example.ts.net`.",
          "type": [
            "string",
            "null"
          ]
        },
        "published": {
          "default": false,
          "description": "Whether `tailscale serve` maps `https_port` to the listener.",
          "type": "boolean"
        },
        "state": {
          "$ref": "#/$defs/TailscaleState"
        }
      },
      "required": [
        "state",
        "https_port"
      ],
      "type": "object"
    },
    "TimelineBody": {
      "oneOf": [
        {
          "properties": {
            "preview": {
              "type": "string"
            },
            "type": {
              "const": "prompt",
              "type": "string"
            }
          },
