          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "line": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "col",
        "line"
      ],
      "type": "object"
    },
    "SessionInfo": {
      "description": "`session.info`: the core that answers.",
      "properties": {
        "api_version": {
          "description": "`neohar/1`.",
          "type": "string"
        },
        "log_epoch": {
          "description": "Changes when the event log starts again. A cursor from another epoch is stale.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "machine_uuid": {
          "type": "string"
        },
        "name": {
          "description": "The name of the session (`default`).",
          "type": "string"
        },
        "pid": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "protocols": {
          "$ref": "#/$defs/Protocols"
        },
        "session_uuid": {
          "type": "string"
        },
        "started_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "version": {
          "description": "The version of the neohar build.",
          "type": "string"
        }
      },
      "required": [
        "name",
        "api_version",
        "version",
        "pid",
        "started_at",
        "session_uuid",
        "machine_uuid",
        "log_epoch",
        "protocols"
      ],
      "type": "object"
    },
    "SessionStopEverything": {
      "description": "`session.stop_everything`: stops every program of every pane, as \"Quit and stop\neverything\" does. The core keeps running.",
      "properties": {
        "force": {
          "default": false,
          "description": "Skip the grace period: the agents get no time to end by themselves, and a program that\nruns after `Term` and `Hup` gets `Kill` at once.",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "SessionStopped": {
      "description": "What `session.stop_everything` did, as numbers of panes.",
      "properties": {
        "ended": {
          "description": "The panes whose program ended after the polite signals.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "killed": {
          "description": "The panes whose program had to be killed.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "left": {
          "description": "The panes whose program still ran at the end. Their holders keep running.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "ended",
        "killed",
        "left"
      ],
      "type": "object"
    },
    "SettingEntry": {
      "properties": {
        "source": {
          "$ref": "#/$defs/SettingSource"
        },
        "value": true
      },
      "required": [
        "value",
        "source"
      ],
      "type": "object"
    },
    "SettingSource": {
      "description": "Where a setting got its value.",
      "enum": [
        "default",
        "file",
        "ui"
      ],
      "type": "string"
    },
    "SettingsSection": {
      "description": "`settings`: one section of the effective config, with provenance.",
      "properties": {
        "entries": {
          "additionalProperties": {
            "$ref": "#/$defs/SettingEntry"
          },
          "type": "object"
        }
      },
      "required": [
        "entries"
      ],
      "type": "object"
    },
    "Source": {
      "description": "Where a piece of state came from, and how sure the core is.",
      "oneOf": [
        {
          "const": "structured",
          "description": "A hook or a protocol message of the harness.",
          "type": "string"
        },
        {
          "const": "screen",
          "description": "The VT screen matched a manifest rule.",
          "type": "string"
        },
        {
          "const": "process",
          "description": "The process tree.",
          "type": "string"
        },
        {
          "const": "holder",
          "description": "The holder.",
          "type": "string"
        },
        {
          "const": "user",
          "description": "The user said so.",
          "type": "string"
        },
        {
          "const": "transcript",
          "description": "A transcript file.",
          "type": "string"
        },
        {
          "const": "derived",
          "description": "The core derived it from other state.",
          "type": "string"
        }
      ]
    },
    "Spans": {
      "description": "Text with highlighted ranges.",
      "properties": {
        "spans": {
          "description": "`[start, end, class]`, in UTF-16 code units.",
          "items": {
            "maxItems": 3,
            "minItems": 3,
            "prefixItems": [
              {
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              },
              {
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "string"
              }
            ],
            "type": "array"
          },
          "type": "array"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "text",
        "spans"
      ],
      "type": "object"
    },
    "SplitDirection": {
      "description": "Which side of a pane a new pane goes on.",
      "enum": [
        "left",
        "right",
        "up",
        "down"
      ],
      "type": "string"
    },
    "StorageHealth": {
      "oneOf": [
        {
          "properties": {
            "state": {
