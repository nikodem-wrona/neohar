{
  "name": "neohar-website",
  "version": "2.0.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "The documentation site of neohar, built with Docusaurus",
  "scripts": {
    "docusaurus": "docusaurus",
    "gen": "bun scripts/gen-all.ts",
    "start": "docusaurus start",
    "build": "docusaurus build",
