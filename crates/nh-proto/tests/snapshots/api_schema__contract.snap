            "preview"
          ],
          "type": "object"
        },
        {
          "properties": {
            "preview": {
              "type": "string"
            },
            "type": {
              "const": "assistant",
              "type": "string"
            }
          },
          "required": [
            "type",
            "preview"
          ],
          "type": "object"
        },
        {
          "properties": {
            "duration_ms": {
              "format": "uint64",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "status": {
              "$ref": "#/$defs/ToolStatus"
            },
            "summary": {
              "type": "string"
            },
            "tool": {
              "type": "string"
            },
            "type": {
