        "installed",
        "transports"
      ],
      "type": "object"
    },
    "IntegrationInstall": {
      "properties": {
        "dry_run": {
          "default": false,
          "type": "boolean"
        },
        "project_root": {
          "description": "The repository for the scope `project`. The CLI gives its working directory.",
          "type": [
            "string",
            "null"
          ]
        },
        "scope": {
          "$ref": "#/$defs/IntegrationScope",
          "default": "user"
        },
        "target": {
          "$ref": "#/$defs/IntegrationTarget"
        }
      },
      "required": [
        "target"
      ],
      "type": "object"
    },
    "IntegrationList": {
      "type": "object"
    },
    "IntegrationListResult": {
      "properties": {
        "integrations": {
          "items": {
            "$ref": "#/$defs/IntegrationInfo"
          },
          "type": "array"
        }
      },
      "required": [
        "integrations"
      ],
      "type": "object"
    },
    "IntegrationScope": {
      "enum": [
        "user",
        "project"
      ],
      "type": "string"
    },
    "IntegrationStatusEntry": {
      "properties": {
        "files": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "harness": {
          "$ref": "#/$defs/Harness"
        },
        "hooks_trusted": {
          "description": "Codex only: every hook is trusted.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "installed": {
          "type": "boolean"
        },
        "last_signal_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "version_validated": {
          "type": "boolean"
        }
      },
      "required": [
        "harness",
        "installed",
        "files",
        "version_validated"
      ],
      "type": "object"
    },
    "IntegrationStatusParams": {
      "properties": {
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/IntegrationTarget"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "IntegrationStatusResult": {
      "properties": {
        "status": {
          "items": {
            "$ref": "#/$defs/IntegrationStatusEntry"
          },
          "type": "array"
        }
      },
      "required": [
        "status"
      ],
      "type": "object"
    },
    "IntegrationTarget": {
      "description": "Which integration. `All` means both harnesses.",
      "enum": [
        "claude",
        "codex",
        "all"
      ],
      "type": "string"
    },
    "IntegrationUninstall": {
      "properties": {
        "project_root": {
          "description": "The repository for the scope `project`. The CLI gives its working directory.",
          "type": [
            "string",
            "null"
          ]
        },
        "scope": {
          "$ref": "#/$defs/IntegrationScope",
          "default": "user"
        },
        "target": {
          "$ref": "#/$defs/IntegrationTarget"
        }
      },
      "required": [
        "target"
      ],
      "type": "object"
    },
    "InteractionAnswer": {
      "description": "`via` goes into the delivery record. A second answer gets `already_answered`.",
      "properties": {
        "decision": {
          "$ref": "#/$defs/Decision"
        },
        "interaction": {
          "$ref": "#/$defs/RefInteractionId"
        },
        "via": {
          "$ref": "#/$defs/Via"
        }
      },
      "required": [
        "interaction",
        "decision",
        "via"
      ],
      "type": "object"
    },
    "InteractionAnswered": {
      "properties": {
        "rev": {
          "description": "The revision of the decision.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "state": {
          "$ref": "#/$defs/InteractionState"
        }
      },
      "required": [
        "rev",
        "state"
      ],
      "type": "object"
    },
    "InteractionCancelled": {
      "properties": {
        "interaction": {
          "$ref": "#/$defs/InteractionId"
        },
        "reason": {
          "description": "For example `process_exited`.",
          "type": "string"
        }
      },
      "required": [
        "interaction",
        "reason"
      ],
      "type": "object"
    },
    "InteractionDecided": {
      "properties": {
        "by": {
          "type": "string"
        },
        "interaction": {
          "$ref": "#/$defs/InteractionId"
        },
        "rev": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "via": {
          "$ref": "#/$defs/Via"
        }
      },
      "required": [
        "interaction",
        "rev",
        "by",
        "via"
      ],
      "type": "object"
    },
    "InteractionDelivery": {
      "description": "The payload of `interaction.delivery_started`, `interaction.delivered` and\n`interaction.delivery_unknown`.",
      "properties": {
        "interaction": {
          "$ref": "#/$defs/InteractionId"
        },
        "rev": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "interaction",
        "rev"
      ],
      "type": "object"
    },
    "InteractionDeliveryFailed": {
      "properties": {
        "interaction": {
          "$ref": "#/$defs/InteractionId"
        },
        "reason": {
          "type": "string"
        },
        "rev": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "interaction",
        "rev",
        "reason"
      ],
      "type": "object"
    },
    "InteractionDismiss": {
      "description": "Closes an interaction without an answer (a notice, or a card the user does not want).",
      "properties": {
        "interaction": {
          "$ref": "#/$defs/RefInteractionId"
        }
      },
      "required": [
        "interaction"
      ],
      "type": "object"
    },
    "InteractionEnded": {
      "description": "The payload of `interaction.resolved_elsewhere` and `interaction.dismissed`.",
      "properties": {
        "interaction": {
          "$ref": "#/$defs/InteractionId"
        }
      },
      "required": [
        "interaction"
      ],
      "type": "object"
    },
    "InteractionId": {
      "description": "The ULID of a interaction, as 26 characters.",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
      "type": "string"
    },
    "InteractionKind": {
      "enum": [
        "approval",
        "question",
        "plan_review",
        "notice"
      ],
      "type": "string"
    },
    "InteractionList": {
      "properties": {
        "limit": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "open_only": {
          "default": true,
          "description": "Only the open ones. It is the default.",
          "type": "boolean"
        },
        "pane": {
          "anyOf": [
            {
              "$ref": "#/$defs/RefPaneId"
            },
            {
              "type": "null"
            }
          ]
        },
        "run": {
          "anyOf": [
            {
              "$ref": "#/$defs/RefRunId"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "InteractionListResult": {
      "properties": {
        "interactions": {
          "items": {
            "$ref": "#/$defs/InteractionValue"
          },
          "type": "array"
        }
      },
      "required": [
        "interactions"
      ],
      "type": "object"
    },
    "InteractionNext": {
      "description": "The most urgent open interaction that a client can answer.",
      "properties": {
        "after": {
          "anyOf": [
            {
              "$ref": "#/$defs/RefInteractionId"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "InteractionNextResult": {
      "properties": {
        "handle": {
          "type": [
            "string",
            "null"
          ]
        },
        "interaction": {
          "anyOf": [
            {
              "$ref": "#/$defs/InteractionId"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "InteractionOpened": {
      "properties": {
        "by_policy": {
          "default": false,
          "description": "Policy decided it at once.",
          "type": "boolean"
        },
        "interaction": {
          "$ref": "#/$defs/InteractionId"
        },
        "kind": {
          "$ref": "#/$defs/InteractionKind"
        },
        "pane": {
          "anyOf": [
            {
              "$ref": "#/$defs/PaneId"
            },
            {
              "type": "null"
            }
          ]
        },
        "risk": {
          "$ref": "#/$defs/Risk"
        },
        "run": {
          "anyOf": [
            {
              "$ref": "#/$defs/RunId"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "interaction",
        "kind",
        "risk"
      ],
      "type": "object"
    },
    "InteractionPayload": {
      "oneOf": [
        {
          "$ref": "#/$defs/ApprovalPayload",
          "properties": {
            "kind": {
              "const": "approval",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "$ref": "#/$defs/QuestionPayload",
          "properties": {
            "kind": {
              "const": "question",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "$ref": "#/$defs/PlanPayload",
          "properties": {
            "kind": {
              "const": "plan_review",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "$ref": "#/$defs/NoticePayload",
          "properties": {
            "kind": {
              "const": "notice",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "InteractionReveal": {
      "description": "Brings an interaction to the person: the app comes to the front, and the window\nshows the inbox with the card focused. It does not answer and does not focus the pane.\nWithout `interaction`, it takes the result of `interaction.next`.",
      "properties": {
        "interaction": {
          "anyOf": [
            {
              "$ref": "#/$defs/RefInteractionId"
            },
            {
              "type": "null"
            }
          ]
        },
        "window": {
          "anyOf": [
            {
              "$ref": "#/$defs/WindowId"
            },
            {
              "type": "null"
            }
          ],
          "description": "The window that shows the card. The default is the window with the OS focus, else the\nfirst one."
        }
      },
      "type": "object"
    },
    "InteractionRevealed": {
      "properties": {
        "interaction": {
          "anyOf": [
            {
              "$ref": "#/$defs/InteractionId"
            },
            {
              "type": "null"
            }
          ],
          "description": "The interaction that the window shows, or none when nothing waits."
        },
        "window": {
          "anyOf": [
            {
              "$ref": "#/$defs/WindowId"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "InteractionShow": {
      "properties": {
        "interaction": {
          "$ref": "#/$defs/RefInteractionId"
        }
      },
      "required": [
        "interaction"
      ],
      "type": "object"
    },
    "InteractionShown": {
      "properties": {
        "interaction": {
          "$ref": "#/$defs/InteractionValue"
        }
      },
      "required": [
        "interaction"
      ],
      "type": "object"
    },
    "InteractionState": {
      "description": "The state of the delivery record, plus how an interaction can end otherwise.",
      "enum": [
        "open",
        "decision_recorded",
        "delivering",
        "delivered",
        "delivery_unknown",
        "failed",
        "superseded",
        "resolved_elsewhere",
        "dismissed",
        "cancelled"
      ],
      "type": "string"
    },
    "InteractionValue": {
      "description": "`interactions`: an approval, a question, a plan review or a notice. The core renders the\npayload once, when the interaction opens.",
      "properties": {
        "always_rule": {
          "description": "The rule that \"Allow always\" adds, such as `pnpm test:*` or `src/app/**`. Only an\napproval that a rule may cover, with an answer through the hook, has it. Without it\nthe core refuses \"always\".",
          "type": [
            "string",
            "null"
          ]
        },
        "answerable": {
          "description": "A client can answer it now. A run that is only suggested is not answerable.",
          "type": "boolean"
        },
        "channels": {
          "description": "The channels that this kind has for this run.",
          "items": {
            "$ref": "#/$defs/AnswerChannel"
          },
          "type": "array"
        },
        "deadline": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "delivery": {
          "$ref": "#/$defs/DeliveryInfo"
        },
        "handle": {
          "description": "The short handle, for example `i42`.",
          "type": "string"
        },
        "id": {
          "$ref": "#/$defs/InteractionId"
        },
        "kind": {
          "$ref": "#/$defs/InteractionKind"
        },
        "mode": {
          "$ref": "#/$defs/GateMode"
        },
        "opened_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "pane": {
          "anyOf": [
            {
              "$ref": "#/$defs/PaneId"
            },
            {
              "type": "null"
            }
          ]
        },
        "payload": {
          "$ref": "#/$defs/InteractionPayload"
        },
        "risk": {
          "$ref": "#/$defs/Risk"
        },
        "run": {
          "anyOf": [
            {
              "$ref": "#/$defs/RunId"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "$ref": "#/$defs/InteractionState"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "handle",
        "kind",
        "state",
        "mode",
        "title",
        "risk",
        "opened_at",
        "payload",
        "delivery",
        "answerable",
        "channels"
      ],
      "type": "object"
    },
    "JobId": {
      "description": "The ULID of a job, as 26 characters.",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
      "type": "string"
    },
    "JobStarted": {
      "description": "The result of a command that runs as a job. Progress is in the `jobs` projection.",
      "properties": {
        "job": {
          "$ref": "#/$defs/JobId"
        }
      },
      "required": [
        "job"
      ],
      "type": "object"
    },
    "JobStatus": {
      "enum": [
        "running",
        "done",
        "failed",
        "cancelled"
      ],
      "type": "string"
    },
    "JobValue": {
      "description": "`jobs`: the progress of a long command.",
      "properties": {
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/CallError"
            },
            {
              "type": "null"
            }
          ]
        },
        "finished_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "$ref": "#/$defs/JobId"
        },
        "message": {
          "type": [
            "string",
            "null"
          ]
        },
        "progress": {
          "description": "From 0 to 1, when the job knows.",
          "format": "float",
          "type": [
            "number",
            "null"
          ]
        },
        "result": {
          "description": "What the job made, when it is done (for example `{\"run\": \"…\"}`)."
        },
        "started_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "status": {
          "$ref": "#/$defs/JobStatus"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "status",
        "started_at"
      ],
      "type": "object"
    },
    "JobsCancel": {
      "properties": {
        "job": {
          "$ref": "#/$defs/JobId"
        }
      },
      "required": [
        "job"
      ],
      "type": "object"
    },
    "JsonRpc": {
      "const": "2.0",
      "type": "string"
    },
    "KeyKind": {
      "description": "What the key did. A client sends `release` only when the pane's frame has the kitty \"report\nevent types\" mode bit.",
      "enum": [
        "press",
        "repeat",
        "release"
      ],
      "type": "string"
    },
    "LaunchMode": {
      "enum": [
        "tui",
        "headless"
      ],
      "type": "string"
    },
    "LayoutChanged": {
      "description": "The layout of a tab changed (a split, a ratio, a float or a zoom).",
      "properties": {
        "tab": {
          "$ref": "#/$defs/TabId"
        }
      },
      "required": [
        "tab"
      ],
      "type": "object"
    },
    "LayoutEqualize": {
      "properties": {
        "path": {
          "default": [],
          "items": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "type": "array"
        },
        "tab": {
          "$ref": "#/$defs/RefTabId"
        }
      },
      "required": [
        "tab"
      ],
      "type": "object"
    },
    "LayoutNode": {
      "description": "The layout of a tab: panes in nested splits. The UI renders it with CSS.",
      "oneOf": [
        {
          "properties": {
            "pane": {
              "$ref": "#/$defs/PaneId"
            },
            "type": {
              "const": "pane",
              "type": "string"
            }
          },
          "required": [
            "type",
            "pane"
          ],
          "type": "object"
        },
        {
          "properties": {
            "axis": {
              "$ref": "#/$defs/Axis"
            },
            "children": {
              "items": {
                "$ref": "#/$defs/LayoutNode"
              },
              "type": "array"
            },
            "ratios": {
              "description": "One share for each child. They add up to 1.",
              "items": {
                "format": "float",
                "type": "number"
              },
              "type": "array"
            },
            "type": {
              "const": "split",
              "type": "string"
            }
          },
          "required": [
            "type",
            "axis",
            "ratios",
            "children"
          ],
          "type": "object"
        }
      ]
    },
    "LayoutSetRatios": {
      "properties": {
        "path": {
          "description": "The split node, as the indices of the children from the root. `[]` is the root.",
          "items": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "type": "array"
        },
        "ratios": {
          "items": {
            "format": "float",
            "type": "number"
          },
          "type": "array"
        },
        "tab": {
          "$ref": "#/$defs/RefTabId"
        }
      },
      "required": [
        "tab",
        "path",
        "ratios"
      ],
      "type": "object"
    },
    "LayoutZoom": {
      "properties": {
        "pane": {
          "anyOf": [
            {
              "$ref": "#/$defs/RefPaneId"
            },
            {
              "type": "null"
            }
          ],
          "description": "The pane to zoom. Without it the zoom ends."
        },
        "tab": {
          "$ref": "#/$defs/RefTabId"
        }
      },
      "required": [
        "tab"
      ],
      "type": "object"
    },
    "LimitValue": {
      "description": "`limits`: the rate limits of an account.",
      "properties": {
        "account": {
          "type": "string"
        },
        "harness": {
          "$ref": "#/$defs/Harness"
        },
        "usage_today": {
          "$ref": "#/$defs/Usage"
        },
        "windows": {
          "items": {
            "$ref": "#/$defs/RateLimitWindow"
          },
          "type": "array"
        }
      },
      "required": [
        "account",
        "harness",
        "windows",
        "usage_today"
      ],
      "type": "object"
    },
    "LineKind": {
      "enum": [
        "ctx",
        "add",
        "del"
      ],
      "type": "string"
    },
    "LineRange": {
      "description": "A line range of the archive of a pane, counted from the first line that the archive holds.\n`to` is not part of the range.",
      "properties": {
        "from": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "to": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "from",
        "to"
      ],
      "type": "object"
    },
    "LinkValue": {
      "description": "`link`: the link of a window to its machine. The host of the client serves it,\nto each window. It has one key, `_`. For a window of the local core the state is `local`.",
      "properties": {
        "changed_at": {
          "$ref": "#/$defs/Timestamp",
          "description": "When the state last changed."
        },
        "machine": {
          "description": "The label of the machine.",
          "type": "string"
        },
        "reason": {
          "description": "Why the link is not connected.",
          "type": [
            "string",
            "null"
          ]
        },
        "rtt_ms": {
          "format": "float",
          "type": [
            "number",
            "null"
          ]
        },
        "state": {
          "$ref": "#/$defs/MachineState"
        },
        "text": {
          "description": "What the status bar shows: `local`, the label of a link that is up, or the label with\nthe state for a link that is not. The host makes it, and the page prints it.",
          "type": "string"
        }
      },
      "required": [
        "machine",
        "state",
        "changed_at",
        "text"
      ],
      "type": "object"
    },
    "Liveness": {
      "oneOf": [
        {
          "properties": {
            "state": {
              "const": "starting",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        },
        {
          "properties": {
            "state": {
              "const": "alive",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        },
        {
          "properties": {
            "code": {
              "format": "int32",
              "type": [
                "integer",
                "null"
              ]
            },
            "state": {
              "const": "exited",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        }
      ]
    },
    "LivenessFacet": {
      "properties": {
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "value": {
          "$ref": "#/$defs/Liveness"
        }
      },
      "required": [
        "value",
        "provenance"
      ],
      "type": "object"
    },
    "LogicalInput": {
      "description": "The `event` of `pane.input`.",
      "oneOf": [
        {
          "$ref": "#/$defs/LogicalKey",
          "properties": {
            "type": {
              "const": "key",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "$ref": "#/$defs/LogicalMouse",
          "properties": {
            "type": {
              "const": "mouse",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "$ref": "#/$defs/LogicalText",
          "properties": {
            "type": {
              "const": "text",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        }
      ]
    },
    "LogicalKey": {
      "description": "A key event. The fields are those of the DOM `KeyboardEvent`, after the client has dealt with\ncomposition, dead keys, `AltGraph` and the Option key of macOS.",
      "properties": {
        "code": {
          "description": "The physical key (`KeyboardEvent.code`), for example `KeyC` or `Numpad1`.",
          "type": "string"
        },
        "key": {
          "description": "The key in the layout of the user (`KeyboardEvent.key`), for example `c`, `C`, `Enter`.",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/KeyKind",
          "default": "press"
        },
        "location": {
          "default": 0,
          "description": "`KeyboardEvent.location`: 0 standard, 1 left, 2 right, 3 numeric keypad.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "mods": {
          "$ref": "#/$defs/Mods",
          "default": []
        },
        "text": {
          "description": "The text that the key produces, when the client knows it. The kitty protocol sends it when\nthe application asks for the associated text.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "code",
        "key"
      ],
      "type": "object"
    },
    "LogicalMouse": {
      "description": "A mouse event at a cell of the grid.",
      "properties": {
        "button": {
          "$ref": "#/$defs/MouseButton",
          "default": "none"
        },
        "col": {
          "description": "The column of the cell, counted from 0 at the left.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "kind": {
          "$ref": "#/$defs/MouseKind"
        },
        "mods": {
          "$ref": "#/$defs/Mods",
          "default": []
        },
        "row": {
          "description": "The row of the cell, counted from 0 at the top.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "wheel_x": {
          "default": 0,
          "description": "Horizontal wheel notches. Positive is to the right, as in `WheelEvent.deltaX`.",
          "format": "int16",
          "maximum": 32767,
          "minimum": -32768,
          "type": "integer"
        },
        "wheel_y": {
          "default": 0,
          "description": "Vertical wheel notches. Positive is down, as in `WheelEvent.deltaY`.",
          "format": "int16",
          "maximum": 32767,
          "minimum": -32768,
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "col",
        "row"
      ],
      "type": "object"
    },
    "LogicalText": {
      "description": "Text that is not a key press: the result of an input method or a dead key.",
      "properties": {
        "text": {
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "type": "object"
    },
    "LoginMethod": {
      "description": "How a harness is logged in, when its probe tells it. The core keeps no account name,\naddress or token.",
      "oneOf": [
        {
          "enum": [
            "api_key"
          ],
          "type": "string"
        },
        {
          "const": "subscription",
          "description": "A subscription account: Claude.ai for Claude Code, ChatGPT for Codex.",
          "type": "string"
        },
        {
          "const": "token",
          "description": "A token that the person gave the harness, for example `CLAUDE_CODE_OAUTH_TOKEN`.",
          "type": "string"
        }
      ]
    },
    "LoginSource": {
      "description": "What gave the login state: the probe of the manifest, or a run that showed it.",
      "enum": [
        "probe",
        "run"
      ],
      "type": "string"
    },
    "LoginState": {
      "description": "The login state of a harness on this machine. `unknown` means that the probe\nfailed, timed out, or gave an output that no rule of the manifest matches.",
      "enum": [
        "logged_in",
        "logged_out",
        "unknown"
      ],
      "type": "string"
    },
    "MachineHarness": {
      "description": "The login state of one harness on a machine, as the row of that machine says it.",
      "properties": {
        "id": {
          "description": "The id of the manifest: `claude` or `codex`.",
          "type": "string"
        },
        "installed": {
          "type": "boolean"
        },
        "login": {
          "$ref": "#/$defs/LoginState"
        }
      },
      "required": [
        "id",
        "installed",
        "login"
      ],
      "type": "object"
    },
    "MachineInfo": {
      "description": "`machine.info`: the machine of the core.",
      "properties": {
        "arch": {
          "type": "string"
        },
        "hostname": {
          "type": [
            "string",
            "null"
          ]
        },
        "label": {
          "description": "The label of the machine. The local machine is `local`.",
          "type": "string"
        },
        "os": {
          "type": "string"
        },
        "uuid": {
          "type": "string"
        }
      },
      "required": [
        "label",
        "uuid",
        "os",
        "arch"
      ],
      "type": "object"
    },
    "MachineList": {
      "description": "`machine.list`: the rows of the projection `machines`, in its order.",
      "properties": {
        "machines": {
          "items": {
            "$ref": "#/$defs/MachineValue"
          },
          "type": "array"
        }
      },
      "required": [
        "machines"
      ],
      "type": "object"
    },
    "MachineState": {
      "enum": [
        "local",
        "connecting",
        "connected",
        "disconnected"
      ],
      "type": "string"
    },
    "MachineTarget": {
      "description": "`machine.connect`, `machine.disconnect` and `machine.open_window`: the label of a machine of\n`config.toml`.",
      "properties": {
        "machine": {
          "type": "string"
        }
      },
      "required": [
        "machine"
      ],
      "type": "object"
    },
    "MachineUpdate": {
      "description": "What the client should do about the version of the core of a machine.",
      "oneOf": [
        {
          "const": "update_available",
          "description": "The core is older than the app. The link works, and the app offers an update.",
          "type": "string"
        },
        {
          "const": "update_app",
          "description": "The core is newer than the app within the major version. The link works, and the app\nasks the person to update the app.",
          "type": "string"
        },
        {
          "const": "version_mismatch",
          "description": "The core is of another major version of the API. The link does not work.",
          "type": "string"
        },
        {
          "const": "install_needed",
          "description": "The machine has no `nh`, or a bridge that does not know `link/1`. The app offers the\ninstall.",
          "type": "string"
        }
      ]
    },
    "MachineValue": {
      "description": "`machines`: the machine of the person and one row for each `[machines.<label>]`.\nThe key is the label. The core orders the rows: `local`, then the order of `config.toml`.",
      "properties": {
        "forwards": {
          "default": [],
          "description": "The ports forwarded to the machine.",
          "items": {
            "$ref": "#/$defs/PortForward"
          },
          "type": "array"
        },
        "harnesses": {
          "default": [],
          "description": "The summary of the harnesses of the machine, copied from its `harnesses` projection.",
          "items": {
            "$ref": "#/$defs/MachineHarness"
          },
          "type": "array"
        },
        "label": {
          "type": "string"
        },
        "latency_ms": {
          "format": "float",
          "type": [
            "number",
            "null"
          ]
        },
        "reason": {
          "description": "Why the link is not connected: the reason of the last disconnect or the last failure.",
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "$ref": "#/$defs/MachineState"
        },
        "update": {
          "anyOf": [
            {
              "$ref": "#/$defs/MachineUpdate"
            },
            {
              "type": "null"
            }
          ]
        },
        "version": {
          "description": "The version of the core of the machine, from `Welcome`.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "label",
        "state"
      ],
      "type": "object"
    },
    "Markdown": {
      "description": "Sanitized HTML (`ammonia`). The UI inserts it only through the `RichHtml` component.",
      "properties": {
        "html": {
          "type": "string"
        },
        "truncated": {
          "default": false,
          "description": "The text was cut at the cap (256 KB for a plan). The UI offers \"open full\".",
          "type": "boolean"
        }
      },
      "required": [
        "html"
      ],
      "type": "object"
    },
    "ModName": {
      "description": "One modifier, in the order of the list form of [`Mods`].",
      "enum": [
        "shift",
        "ctrl",
        "alt",
        "meta",
        "caps_lock",
        "num_lock"
      ],
      "type": "string"
    },
    "ModelChoice": {
      "properties": {
        "efforts": {
          "description": "The effort levels of this model. Empty: the levels of the harness.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "id": {
          "description": "What goes on the command line.",
          "type": "string"
        },
        "label": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "label"
      ],
      "type": "object"
    },
    "Mods": {
      "description": "The modifiers that were active when an event happened.\n\nOn the wire this is a list of names (`[\"ctrl\", \"shift\"]`), in the order of the fields, so a\nreader sees the chord. `meta` is the Command key on macOS and the Windows key elsewhere; the\nkitty keyboard protocol calls it `super`. `caps_lock` and `num_lock` are the lock states, not\nkey presses.",
      "items": {
        "$ref": "#/$defs/ModName"
      },
      "type": "array"
    },
    "MouseButton": {
      "description": "A mouse button.",
      "enum": [
        "none",
        "left",
        "middle",
        "right"
      ],
      "type": "string"
    },
    "MouseKind": {
      "description": "What a mouse event is.",
      "oneOf": [
        {
          "enum": [
            "down",
            "up",
            "wheel"
          ],
          "type": "string"
        },
        {
          "const": "move",
          "description": "The pointer moved. `button` is the button that is held, if any.",
          "type": "string"
        }
      ]
    },
    "MouseMode": {
      "description": "The mouse protocol that the program in the pane asked for.",
      "enum": [
        "none",
        "x10",
        "normal",
        "button_event",
        "any_event"
      ],
      "type": "string"
    },
    "NoticePayload": {
      "properties": {
        "resets_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "type": "object"
    },
    "Notification": {
      "description": "A message of the server without an id: `events.event`, `projection.message` and the like.",
      "properties": {
        "jsonrpc": {
          "$ref": "#/$defs/JsonRpc"
        },
        "method": {
          "type": "string"
        },
        "params": {
          "default": null
        }
      },
      "required": [
        "jsonrpc",
        "method"
      ],
      "type": "object"
    },
    "NotificationId": {
      "description": "The ULID of a notification, as 26 characters.",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
      "type": "string"
    },
    "NotificationValue": {
      "description": "`notifications`.",
      "properties": {
        "at": {
          "$ref": "#/$defs/Timestamp"
        },
        "id": {
          "$ref": "#/$defs/NotificationId"
        },
        "interaction": {
          "anyOf": [
            {
              "$ref": "#/$defs/InteractionId"
            },
            {
              "type": "null"
            }
          ]
        },
        "seen": {
          "type": "boolean"
        },
        "text": {
          "type": "string"
        },
        "urgency": {
          "$ref": "#/$defs/Urgency"
        }
      },
      "required": [
        "id",
        "at",
        "text",
        "urgency",
        "seen"
      ],
      "type": "object"
    },
    "PairingState": {
      "description": "The state of the offer of a pairing.",
      "oneOf": [
        {
          "const": "none",
          "description": "No offer.",
          "type": "string"
        },
        {
          "const": "waiting",
          "description": "An offer waits for a phone.",
          "type": "string"
        },
        {
          "const": "paired",
          "description": "A phone paired with the offer.",
          "type": "string"
        },
        {
          "const": "expired",
          "description": "The offer ended: its time ran out, or five codes were wrong.",
          "type": "string"
        }
      ]
    },
    "PaletteCommand": {
      "properties": {
        "category": {
          "type": "string"
        },
        "disabled_reason": {
          "description": "Why a command is disabled, for the hint.",
          "type": [
            "string",
            "null"
          ]
        },
        "enabled": {
          "type": "boolean"
        },
        "id": {
          "type": "string"
        },
        "shortcut": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "category",
        "enabled"
      ],
      "type": "object"
    },
    "PaletteExecute": {
      "properties": {
        "args": true,
        "command": {
          "description": "The id of the command (`PaletteCommand.id`).",
          "type": "string"
        },
        "window": {
          "anyOf": [
            {
              "$ref": "#/$defs/WindowId"
            },
            {
              "type": "null"
            }
          ],
          "description": "The window that runs the command. A command on the tab or the pane in focus needs it."
        }
      },
      "required": [
        "command"
      ],
      "type": "object"
    },
    "PaletteExecuted": {
      "description": "What `palette.execute` did. Some commands belong to the page and not to the core, for\nexample the search. The core then names the action, and the page does it.",
      "properties": {
        "ui": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "PaletteMatch": {
      "properties": {
        "command": {
          "$ref": "#/$defs/PaletteCommand"
        },
        "ranges": {
          "description": "The matched ranges of the title, in UTF-16 code units.",
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              },
              {
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              }
            ],
            "type": "array"
          },
          "type": "array"
        },
        "score": {
          "format": "float",
          "type": "number"
        }
      },
      "required": [
        "command",
        "score",
        "ranges"
      ],
      "type": "object"
    },
    "PaletteQuery": {
      "properties": {
        "limit": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "query": {
          "type": "string"
        },
        "window": {
          "anyOf": [
            {
              "$ref": "#/$defs/WindowId"
            },
            {
              "type": "null"
            }
          ],
          "description": "The window that asks. A later version ranks the commands of that window first."
        }
      },
      "required": [
        "query"
      ],
      "type": "object"
    },
    "PaletteResults": {
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/PaletteMatch"
          },
          "type": "array"
        }
      },
      "required": [
        "items"
      ],
      "type": "object"
    },
    "PaletteValue": {
      "description": "`palette`: the command list with the enablement of the moment. It has one key, `_`.",
      "properties": {
        "commands": {
          "items": {
            "$ref": "#/$defs/PaletteCommand"
          },
          "type": "array"
        }
      },
      "required": [
        "commands"
      ],
      "type": "object"
    },
    "PaneAck": {
      "description": "One painted frame. `pane` is the render id that the frames carry.",
      "properties": {
        "pane": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "rev": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "pane",
        "rev"
      ],
      "type": "object"
    },
    "PaneBell": {
      "description": "The program in the pane rang the bell. The core sends at most one event in 2 seconds for\na pane.",
      "properties": {
        "pane": {
          "$ref": "#/$defs/PaneId"
        }
      },
      "required": [
        "pane"
      ],
      "type": "object"
    },
    "PaneClaim": {
      "description": "The window takes the geometry lease of the pane as an input does, with the same debounce,\nand sends no byte. A phone calls it when its keyboard opens.",
      "properties": {
        "pane": {
          "$ref": "#/$defs/RefPaneId"
        },
        "window": {
          "$ref": "#/$defs/WindowId"
        }
      },
      "required": [
        "pane",
        "window"
      ],
      "type": "object"
    },
    "PaneClipboardAllow": {
      "description": "The answer to an OSC 52 clipboard write.",
      "properties": {
        "allow": {
          "type": "boolean"
        },
        "pane": {
          "$ref": "#/$defs/RefPaneId"
        },
        "remember": {
          "default": false,
          "description": "Later writes of this pane follow the answer without asking.",
          "type": "boolean"
        },
        "return_text": {
          "default": false,
          "description": "Return the text, and write no clipboard of a host: a phone writes it in the tap.",
          "type": "boolean"
        }
      },
      "required": [
        "pane",
        "allow"
      ],
      "type": "object"
    },
    "PaneClose": {
      "description": "`confirm_required` when the child is alive and `force` is false. `details` has\n`{process, is_agent}`.",
      "properties": {
        "force": {
          "default": false,
          "type": "boolean"
        },
        "pane": {
          "$ref": "#/$defs/RefPaneId"
        }
      },
      "required": [
        "pane"
      ],
      "type": "object"
    },
    "PaneCopy": {
      "description": "Writes the selection to the clipboard through the host.",
      "properties": {
        "pane": {
          "$ref": "#/$defs/RefPaneId"
        },
        "return_text": {
          "default": false,
          "description": "Also return the text, for the CLI and for a phone.\n\nA phone writes its own clipboard in the tap, so the core writes none for it.",
          "type": "boolean"
        }
      },
      "required": [
        "pane"
      ],
      "type": "object"
    },
    "PaneCreated": {
      "properties": {
        "handle": {
          "type": "string"
        },
        "pane": {
          "$ref": "#/$defs/PaneId"
        }
      },
      "required": [
        "pane",
        "handle"
      ],
      "type": "object"
    },
    "PaneDropBlobs": {
      "description": "Files dropped on a pane of a remote window. The client has put each file in the\nblob store over its link. The core writes each blob to a file of the machine of the pane,\nthen quotes the paths and pastes them as `pane.drop_files` does.",
      "properties": {
        "blobs": {
          "items": {
            "$ref": "#/$defs/DroppedBlob"
          },
          "type": "array"
        },
        "input_id": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "pane": {
          "$ref": "#/$defs/RefPaneId"
        }
      },
      "required": [
        "pane",
        "input_id",
        "blobs"
      ],
      "type": "object"
    },
    "PaneDropFiles": {
      "description": "The core quotes the paths and pastes them.",
      "properties": {
        "input_id": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "pane": {
          "$ref": "#/$defs/RefPaneId"
        },
        "paths": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "pane",
        "input_id",
        "paths"
      ],
      "type": "object"
    },
    "PaneEvent": {
      "description": "The payload of the `pane.*` events that name a pane and its place.",
      "properties": {
        "handle": {
          "type": "string"
        },
        "pane": {
          "$ref": "#/$defs/PaneId"
        },
        "tab": {
          "$ref": "#/$defs/TabId"
        },
        "workspace": {
          "$ref": "#/$defs/WorkspaceId"
        }
      },
      "required": [
        "pane",
        "handle",
        "tab",
        "workspace"
      ],
      "type": "object"
    },
    "PaneExited": {
      "properties": {
        "code": {
          "format": "int32",
          "type": [
            "integer",
            "null"
          ]
        },
        "pane": {
          "$ref": "#/$defs/PaneId"
        }
      },
      "required": [
        "pane"
      ],
      "type": "object"
    },
    "PaneFloat": {
      "properties": {
        "pane": {
          "$ref": "#/$defs/RefPaneId"
        },
        "rect": {
          "anyOf": [
            {
              "$ref": "#/$defs/Rect"
            },
            {
              "type": "null"
            }
          ],
          "description": "Where to put it. Without it the core picks a rectangle."
        }
      },
      "required": [
        "pane"
      ],
      "type": "object"
    },
    "PaneFocus": {
      "description": "Keyboard focus moved to a pane in a window.",
      "properties": {
        "pane": {
          "$ref": "#/$defs/RefPaneId"
        },
        "window": {
          "$ref": "#/$defs/WindowId"
        }
      },
      "required": [
        "window",
        "pane"
      ],
      "type": "object"
    },
    "PaneId": {
      "description": "The ULID of a pane, as 26 characters.",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
      "type": "string"
    },
    "PaneInput": {
      "description": "One logical event, at once. `input_id` is unique for the core epoch. A holder\ndrops a repeated id.",
      "properties": {
        "event": {
          "$ref": "#/$defs/LogicalInput"
        },
        "input_id": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "pane": {
          "$ref": "#/$defs/RefPaneId"
        }
      },
      "required": [
        "pane",
        "input_id",
        "event"
      ],
      "type": "object"
    },
    "PaneInputUnconfirmed": {
      "description": "An input was in flight when the holder or the core went away.",
      "properties": {
        "input_id": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "pane": {
          "$ref": "#/$defs/PaneId"
        },
        "reason": {
          "$ref": "#/$defs/UnconfirmedReason"
        }
      },
      "required": [
        "pane",
        "input_id",
        "reason"
      ],
      "type": "object"
    },
    "PaneInsertPaths": {
      "description": "Paths of the machine of the core, from the Files tab. The core quotes and pastes\nthem as `pane.drop_files` does, and the host never uploads them.",
      "properties": {
        "input_id": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "pane": {
          "$ref": "#/$defs/RefPaneId"
        },
        "paths": {
          "description": "1 to 20 absolute paths.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "pane",
        "input_id",
        "paths"
      ],
