{
  "name": "neohar",
  "private": true,
  "version": "1.0.0",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "packages/*",
    "apps/*",
    "tests/*",
    "tools/gen-ts",
    "tools/eslint-plugin-neohar",
    "tools/nh-keytest"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "bun run --filter '@neohar/*' typecheck && tsc --noEmit -p scripts",
    "fmt": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs,css,json}\"",
    "fmt:check": "prettier --check \"**/*.{ts,tsx,js,mjs,cjs,css,json}\""
  },
  "devDependencies": {
    "@neohar/eslint-plugin": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.4.2",
    "@types/estree": "^1.0.9",
    "@types/estree-jsx": "^1.0.5",
    "eslint": "^10.12.0",
    "material-icon-theme": "5.39.0",
    "prettier": "^3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
