      "required": [
        "input_tokens",
        "output_tokens",
        "cache_read_tokens",
        "cache_write_tokens"
      ],
      "type": "object"
    },
    "Via": {
      "description": "The surface a client answers from. The delivery record keeps it.",
      "oneOf": [
        {
          "enum": [
            "card",
            "notification",
            "tray",
            "palette",
            "cli"
          ],
          "type": "string"
        },
        {
          "const": "policy",
          "description": "A rule of the policy decided (step 2). No client answered.",
          "type": "string"
        },
        {
          "const": "phone",
          "description": "The phone app.",
          "type": "string"
        }
      ]
    },
    "WaitFor": {
      "oneOf": [
        {
          "const": "idle",
          "description": "Execution is `idle`.",
          "type": "string"
        },
        {
          "const": "exited",
          "description": "The process ended.",
          "type": "string"
        },
        {
          "const": "attention",
          "description": "The run has an open interaction, or it is in `error` or `rate_limited`.",
          "type": "string"
        }
      ]
    },
    "WindowClose": {
      "properties": {
        "window": {
          "$ref": "#/$defs/WindowId"
        }
      },
      "required": [
        "window"
      ],
      "type": "object"
    },
    "WindowEvent": {
      "description": "The payload of the `window.*` events.",
      "properties": {
        "window": {
          "$ref": "#/$defs/WindowId"
        }
      },
      "required": [
        "window"
      ],
      "type": "object"
    },
    "WindowFocusReport": {
      "description": "Focus and visibility from the OS and the page, for gate mode and pacing.",
      "properties": {
        "active_pane": {
          "anyOf": [
            {
              "$ref": "#/$defs/RefPaneId"
            },
            {
              "type": "null"
            }
          ],
          "description": "The pane whose surface is the active element of the page. `null` when focus is in\nchrome such as the palette."
        },
        "focused": {
          "type": "boolean"
        },
        "minimized": {
          "default": false,
          "type": "boolean"
        },
        "panes_hidden": {
          "default": false,
          "description": "A view of the page covers the panes, for example the Git view. The window gets no\nframes, and it gets a keyframe of each pane when the view closes.",
          "type": "boolean"
        },
        "refresh_hz": {
          "format": "float",
          "type": [
            "number",
            "null"
          ]
        },
        "visible": {
          "type": "boolean"
        },
        "window": {
          "$ref": "#/$defs/WindowId"
        }
      },
      "required": [
        "window",
        "focused",
        "visible"
      ],
      "type": "object"
    },
    "WindowId": {
      "description": "The ULID of a window, as 26 characters.",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
      "type": "string"
    },
    "WindowOpen": {
      "properties": {
        "bounds": {
          "anyOf": [
            {
              "$ref": "#/$defs/Bounds"
            },
            {
              "type": "null"
            }
          ]
        },
        "panes": {
          "default": [],
          "description": "The panes to show. Without them the window shows `tab`.",
          "items": {
            "$ref": "#/$defs/RefPaneId"
          },
          "type": "array"
        },
        "tab": {
          "anyOf": [
            {
              "$ref": "#/$defs/RefTabId"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "WindowOpened": {
      "properties": {
        "window": {
          "$ref": "#/$defs/WindowId"
        }
      },
      "required": [
        "window"
      ],
      "type": "object"
    },
    "WindowReportMetrics": {
      "description": "What the page measured.",
      "properties": {
        "cell_height_px": {
          "format": "float",
          "type": "number"
        },
        "cell_width_px": {
          "format": "float",
          "type": "number"
        },
        "device_pixel_ratio": {
          "format": "float",
          "type": "number"
        },
        "gpu": {
          "type": [
            "string",
            "null"
          ]
        },
        "renderer": {
          "$ref": "#/$defs/RendererKind"
        },
        "window": {
          "$ref": "#/$defs/WindowId"
        }
      },
      "required": [
        "window",
        "cell_width_px",
        "cell_height_px",
        "device_pixel_ratio",
        "renderer"
      ],
      "type": "object"
    },
    "WindowSetBounds": {
      "properties": {
        "bounds": {
          "$ref": "#/$defs/Bounds"
        },
        "window": {
          "$ref": "#/$defs/WindowId"
        }
      },
      "required": [
        "window",
        "bounds"
      ],
      "type": "object"
    },
    "WindowSetSingle": {
      "description": "The single view of a window. With `single`, the window draws only its\nfocused pane, or the first pane of its tab when no pane of the tab has the focus.",
      "properties": {
        "single": {
          "type": "boolean"
        },
        "window": {
          "$ref": "#/$defs/WindowId"
        }
      },
      "required": [
        "window",
        "single"
      ],
      "type": "object"
    },
    "WindowSetVisiblePanes": {
      "properties": {
        "panes": {
          "items": {
            "$ref": "#/$defs/RefPaneId"
          },
          "type": "array"
        },
        "window": {
          "$ref": "#/$defs/WindowId"
        }
      },
      "required": [
        "window",
        "panes"
      ],
      "type": "object"
    },
    "WindowValue": {
      "description": "`windows`: one app window. Restored on launch.",
      "properties": {
        "bounds": {
          "anyOf": [
            {
              "$ref": "#/$defs/Bounds"
            },
            {
              "type": "null"
            }
          ]
        },
        "client": {
          "anyOf": [
            {
              "$ref": "#/$defs/DeviceId"
            },
            {
              "type": "null"
            }
          ],
          "description": "The device id of the client that owns the window. A client opens a native\nwindow only for its own rows. A row with none waits for the first client that attaches."
        },
        "focused": {
          "description": "The OS focus of the window, as the host reports it.",
          "type": "boolean"
        },
        "focused_pane": {
          "anyOf": [
            {
              "$ref": "#/$defs/PaneId"
            },
            {
              "type": "null"
            }
          ],
          "description": "The pane that has keyboard focus in the window."
        },
        "id": {
          "$ref": "#/$defs/WindowId"
        },
        "refresh_hz": {
          "format": "float",
          "type": [
            "number",
            "null"
          ]
        },
        "reveal": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reveal"
            },
            {
              "type": "null"
            }
          ],
          "description": "The interaction that the window must show now (`interaction.reveal`). The window\nacts when `seq` changes."
        },
        "single": {
          "default": false,
          "description": "The single view of a phone: the window draws only its focused pane,\nor the first pane of its tab. The core keeps it in memory only.",
          "type": "boolean"
        },
        "tab": {
          "anyOf": [
            {
              "$ref": "#/$defs/TabId"
            },
            {
              "type": "null"
            }
          ],
          "description": "The tab that the window shows."
        },
        "visible": {
          "type": "boolean"
        },
        "visible_panes": {
          "description": "The panes that the window draws. The render pacer keys on this.",
          "items": {
            "$ref": "#/$defs/PaneId"
          },
          "type": "array"
        },
        "workspace": {
          "anyOf": [
            {
              "$ref": "#/$defs/WorkspaceId"
            },
            {
              "type": "null"
            }
          ],
          "description": "The workspace of that tab. The tab bar shows its tabs."
        }
      },
      "required": [
        "id",
        "visible_panes",
        "focused",
        "visible"
      ],
      "type": "object"
    },
    "WorkspaceClose": {
      "description": "`confirm_required` when a pane has a live process and `force` is false.",
      "properties": {
        "force": {
          "default": false,
          "type": "boolean"
        },
        "workspace": {
          "$ref": "#/$defs/RefWorkspaceId"
        }
      },
      "required": [
        "workspace"
      ],
      "type": "object"
    },
    "WorkspaceCreate": {
      "properties": {
        "command": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProcessSpec"
            },
            {
              "type": "null"
            }
          ],
          "description": "What the first pane runs."
        },
        "group": {
          "anyOf": [
            {
              "$ref": "#/$defs/RefGroupId"
            },
            {
              "type": "null"
            }
          ]
        },
        "machine": {
          "description": "The label of the machine. Without it the workspace is local.",
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "root": {
          "description": "The root path. It is the cwd of the first pane.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "WorkspaceCreated": {
      "description": "A workspace starts with one tab that has one pane.",
      "properties": {
        "handle": {
          "type": "string"
        },
        "pane": {
          "$ref": "#/$defs/PaneId"
        },
        "pane_handle": {
          "type": "string"
        },
        "tab": {
          "$ref": "#/$defs/TabId"
        },
        "tab_handle": {
          "type": "string"
        },
        "workspace": {
          "$ref": "#/$defs/WorkspaceId"
        }
      },
      "required": [
        "workspace",
        "handle",
        "tab",
        "tab_handle",
        "pane",
        "pane_handle"
      ],
      "type": "object"
    },
    "WorkspaceEvent": {
      "description": "The payload of the `workspace.*` events.",
      "properties": {
        "handle": {
          "type": "string"
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "workspace": {
          "$ref": "#/$defs/WorkspaceId"
        }
      },
      "required": [
        "workspace",
        "handle"
      ],
      "type": "object"
    },
    "WorkspaceId": {
      "description": "The ULID of a workspace, as 26 characters.",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
      "type": "string"
    },
    "WorkspaceList": {
      "properties": {
        "group": {
          "anyOf": [
            {
              "$ref": "#/$defs/RefGroupId"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "WorkspaceListResult": {
      "properties": {
        "workspaces": {
          "items": {
            "$ref": "#/$defs/WorkspaceSummary"
          },
          "type": "array"
        }
      },
      "required": [
        "workspaces"
      ],
      "type": "object"
    },
    "WorkspaceMove": {
      "description": "Moves a workspace in the sidebar.",
      "properties": {
        "before": {
          "anyOf": [
            {
              "$ref": "#/$defs/RefWorkspaceId"
            },
            {
              "type": "null"
            }
          ],
          "description": "Put it before this workspace. Without it the workspace goes to the end."
        },
        "group": {
          "anyOf": [
            {
              "$ref": "#/$defs/RefGroupId"
            },
            {
              "type": "null"
            }
          ],
          "description": "The group to put it in. Without it the workspace has no group."
        },
        "workspace": {
          "$ref": "#/$defs/RefWorkspaceId"
        }
      },
      "required": [
        "workspace"
      ],
      "type": "object"
    },
    "WorkspaceRename": {
      "properties": {
        "name": {
          "type": "string"
        },
        "workspace": {
          "$ref": "#/$defs/RefWorkspaceId"
        }
      },
      "required": [
        "workspace",
        "name"
      ],
      "type": "object"
    },
    "WorkspaceShow": {
      "properties": {
        "workspace": {
          "$ref": "#/$defs/RefWorkspaceId"
        }
      },
      "required": [
        "workspace"
      ],
      "type": "object"
    },
    "WorkspaceShown": {
      "properties": {
        "workspace": {
          "$ref": "#/$defs/WorkspaceValue"
        }
      },
      "required": [
        "workspace"
      ],
      "type": "object"
    },
    "WorkspaceSummary": {
      "properties": {
        "agents": {
          "description": "The panes of the workspace that have a live agent run.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "group": {
          "anyOf": [
            {
              "$ref": "#/$defs/GroupId"
            },
            {
              "type": "null"
            }
          ]
        },
        "handle": {
          "type": "string"
        },
        "id": {
          "$ref": "#/$defs/WorkspaceId"
        },
        "name": {
          "type": "string"
        },
        "panes": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "root": {
          "type": [
            "string",
            "null"
          ]
        },
        "tabs": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "handle",
        "name",
        "tabs",
        "panes",
        "agents"
      ],
      "type": "object"
    },
    "WorkspaceValue": {
      "description": "`tree`: a workspace with its tabs.",
      "properties": {
        "group": {
          "anyOf": [
            {
              "$ref": "#/$defs/GroupRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "handle": {
          "description": "The short handle, for example `w3`.",
          "type": "string"
        },
        "id": {
          "$ref": "#/$defs/WorkspaceId"
        },
        "machine": {
          "description": "The label of the machine. The local machine is `local`.",
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "root": {
          "type": [
            "string",
            "null"
          ]
        },
        "selected_tab": {
          "anyOf": [
            {
              "$ref": "#/$defs/TabId"
            },
            {
              "type": "null"
            }
          ]
        },
        "tabs": {
          "items": {
            "$ref": "#/$defs/TabValue"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "handle",
        "name",
        "machine",
        "tabs"
      ],
      "type": "object"
    }
  },
